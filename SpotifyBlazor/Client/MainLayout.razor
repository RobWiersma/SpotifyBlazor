@implements IAsyncDisposable
@inherits LayoutComponentBase
@inject ConfigService Config
@inject SpotifyAuthService Auth
@inject NavigationManager Navigation
@inject TelemetryService Telemetry
@using SpotifyBlazor.Client.Shared
@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Layout
@using SpotifyBlazor.Client.Services

<div class="layout-root">

    <div class="layout-content">

        <div class="content-root d-flex flex-column flex-grow-1">

            <SpotHeader />

            <input value="@SearchText"
                   @oninput="OnSearchInput"
                   @onkeydown="HandleSearchKey"
                   placeholder="Search…"
                   class="search-box" />

            <main class="flex-grow-1">
                <article class="content px-4">
                    @Body
                </article>
            </main>

        </div>

        <PlayerBar />

    </div>

</div>

@code {
    string SearchText = "";
    CancellationTokenSource? debounceCts;

    // ---------------------------------------------------------
    // INITIALIZATION
    // ---------------------------------------------------------
    protected override void OnInitialized()
    {
        // Subscribe to login state changes
        Auth.LoginStateChanged += OnLoginStateChanged;
    }

    private void OnLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            // Optional telemetry when layout becomes authenticated
            Telemetry.TrackAsync(
                "Info",
                "LayoutAuthenticated",
                page: "MainLayout",
                component: "AuthState",
                action: "LoginComplete"
            );
        }
    }

    // ---------------------------------------------------------
    // SEARCH INPUT TELEMETRY (GUARDED)
    // ---------------------------------------------------------
    void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(250, token).ConfigureAwait(false);

                if (!token.IsCancellationRequested)
                {
                    // Prevent telemetry before login
                    if (Auth.State != LoginState.LoggedIn)
                        return;

                    await Telemetry.TrackTimedAsync(
                        "Info",
                        "SearchStarted",
                        async () => { },               // required action
                        context: SearchText,
                        page: "MainLayout",
                        component: "SearchBox",
                        actionName: "Typing"
                    ).ConfigureAwait(false);
                }
            }
            catch { }
        });
    }

    // ---------------------------------------------------------
    // SEARCH SUBMIT TELEMETRY (GUARDED)
    // ---------------------------------------------------------
    void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (Auth.State == LoginState.LoggedIn)
            {
                Telemetry.TrackAsync(
                    "Info",
                    "SearchSubmitted",
                    context: SearchText,
                    page: "MainLayout",
                    component: "SearchBox",
                    action: "Submit"
                );
            }

            Navigation.NavigateTo($"/search?q={SearchText}", forceLoad: true);
        }
    }

    // ---------------------------------------------------------
    // DISPOSAL
    // ---------------------------------------------------------
    public async ValueTask DisposeAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        Auth.LoginStateChanged -= OnLoginStateChanged;
    }

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        Auth.LoginStateChanged -= OnLoginStateChanged;
    }
}
