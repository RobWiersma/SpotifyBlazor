@implements IAsyncDisposable
@inherits LayoutComponentBase
@inject ConfigService Config
@inject SpotifyAuthService Auth
@inject NavigationManager Navigation
@inject TelemetryService Telemetry
@using SpotifyBlazor.Client.Shared
@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Layout
@using SpotifyBlazor.Client.Services

<div class="layout-root">

    <div class="layout-content">

        <div class="content-root d-flex flex-column flex-grow-1">

            <SpotHeader />

            <input value="@SearchText"
                   @oninput="OnSearchInput"
                   @onkeydown="HandleSearchKey"
                   placeholder="Search…"
                   class="search-box" />

            <main class="flex-grow-1">
                <article class="content px-4">
                    @Body
                </article>
            </main>

        </div>

        <PlayerBar />

    </div>

</div>

@code {
    string SearchText = "";
    CancellationTokenSource? debounceCts;

    void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(250, token).ConfigureAwait(false);

                if (!token.IsCancellationRequested)
                {
                    await Telemetry.TrackTimedAsync(
                        "Info",
                        "SearchStarted",
                        async () => { },               // required action
                        context: SearchText,
                        page: "MainLayout",
                        component: "SearchBox",
                        actionName: "Typing"
                    ).ConfigureAwait(false);
                }
            }
            catch { }
        });
    }

    void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Telemetry.TrackAsync(
                "Info",
                "SearchSubmitted",
                context: SearchText,
                page: "MainLayout",
                component: "SearchBox",
                action: "Submit"
            );

            Navigation.NavigateTo($"/search?q={SearchText}", forceLoad: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }

    
}
