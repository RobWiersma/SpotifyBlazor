@page "/album/{AlbumId}"
@implements IDisposable

@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject NavigationManager Navigation
@inject TelemetryService Telemetry

<AnimatedPage>
    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to view this album.</p>
        </div>
    }
    else if (album == null)
    {
        <p class="page-message">Loading album…</p>
    }
    else
    {
        <div class="media-header">
            <img src="@album.Images.FirstOrDefault()?.Url"
                 class="media-header-cover" alt="" />

            <div class="media-header-info">
                <div class="media-header-kicker">Album</div>
                <h1 class="media-header-title">@album.Name</h1>
                <div class="media-header-meta">
                    @foreach (var a in album.Artists)
                    {
                        <span class="text-link fw-bold"
                              @onclick="@(() => Navigation.NavigateTo($"/artist/{a.Id}"))">@a.Name</span>
                        @if (a != album.Artists.Last())
                        {
                            <span>, </span>
                        }
                    }
                    • @album.ReleaseDate • @album.Tracks.Items.Count songs
                </div>
            </div>
        </div>

        <div class="track-list">
            @foreach (var trackObj in album.Tracks.Items)
            {
                <div class="track-row" @onclick="() => Play(trackObj)">

                    <div class="track-row-num">
                        <span class="track-row-num-text">@trackObj.TrackNumber</span>
                        <span class="track-row-num-play">▶</span>
                    </div>

                    <div class="track-row-info">
                        <div class="track-row-name">@trackObj.Name</div>
                        <div class="track-row-sub">
                            @string.Join(", ", trackObj.Artists.Select(a => a.Name))
                        </div>
                    </div>

                    <button class="like-btn"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavorite(trackObj)"
                            title="@(_favoriteTracks.Contains(trackObj.Id) ? "Remove from Liked Songs" : "Add to Liked Songs")">
                        @(_favoriteTracks.Contains(trackObj.Id) ? "💚" : "➕")
                    </button>

                    <div class="track-row-meta">@FormatTime(trackObj.DurationMs)</div>
                </div>
            }
        </div>
    }
</AnimatedPage>

@code {
    [Parameter] public string AlbumId { get; set; } = "";

    private SpotifyAlbum? album;
    private SpotifyArtist? artist;

    private HashSet<string> _favoriteTracks = new();


    // --- INIT ---

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadAlbum();

            await Telemetry.TrackAsync(
                level: "Info",
                message: $"Album selected: {album?.Name}",
                context: $"Artist: {artist?.Name}",
                page: "AlbumPage",
                component: "AlbumDetails",
                action: "AlbumSelected"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadAlbum();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    // --- LOAD ALBUM ---

    private async Task LoadAlbum()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        album = await Auth.GetAlbumAsync(AlbumId);
        artist = album?.Artists?.FirstOrDefault();

        await LoadFavoriteStates();
    }


    private async Task LoadFavoriteStates()
    {
        _favoriteTracks.Clear();

        if (album?.Tracks?.Items == null)
            return;

        var tracks = album.Tracks.Items
            .Where(t => !string.IsNullOrEmpty(t.Id))
            .ToList();

        if (tracks.Count == 0)
            return;

        var uris = tracks
            .Select(t => $"spotify:track:{t.Id}")
            .ToList();

        var results = await Auth.AreFavoritesAsync(uris);

        for (int i = 0; i < tracks.Count && i < results.Length; i++)
        {
            if (results[i])
                _favoriteTracks.Add(tracks[i].Id);
        }
    }


    // --- FAVORITES ---

    private async Task ToggleFavorite(SpotifyTrack track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        if (string.IsNullOrEmpty(track.Id))
            return;

        string uri = $"spotify:track:{track.Id}";

        bool isFavorite = _favoriteTracks.Contains(track.Id);

        if (isFavorite)
        {
            await Auth.RemoveFromLibraryAsync(uri);
            _favoriteTracks.Remove(track.Id);
        }
        else
        {
            await Auth.SaveToLibraryAsync(uri);
            _favoriteTracks.Add(track.Id);
        }

        StateHasChanged();
    }


    // --- PLAYBACK ---

    private async Task Play(SpotifyTrack track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        int index = album?.Tracks?.Items.FindIndex(t => t.Id == track.Id) ?? -1;

        if (index < 0)
            index = track.TrackNumber - 1;

        if (index < 0)
            index = 0;

        await Auth.PlayTrackInContextAsync(album!.Uri, index);

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Track played: {track.Name}",
            context: $"Album: {album?.Name}, Artist: {artist?.Name}",
            page: "AlbumPage",
            component: "TrackList",
            action: "TrackPlayed"
        );
    }


    // --- HELPERS ---

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}