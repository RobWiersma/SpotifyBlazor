@page "/album/{AlbumId}"
@implements IDisposable

@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject NavigationManager Navigation
@inject TelemetryService Telemetry

<AnimatedPage>
    @if (Auth.State != LoginState.LoggedIn)
    {
        <p class="text-warning">You must be logged in to view this album.</p>
    }
    else if (album == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="d-flex gap-4">

            <img src="@album.Images.FirstOrDefault()?.Url"
                 style="width:200px; border-radius:8px;" />

            <div>
                <h3>@album.Name</h3>
                <p>@string.Join(", ", album.Artists.Select(a => a.Name))</p>
                <p>Released: @album.ReleaseDate</p>
            </div>
        </div>

        <h4 class="mt-4">Tracks</h4>

        <ul class="list-group">
            @foreach (var trackObj in album.Tracks.Items)
            {
                <div class="track-row" @onclick="() => Play(trackObj)">
                    <img src="@album.Images.First().Url" class="track-art" />

                    <div class="track-info">
                        <div class="track-title">@trackObj.Name</div>
                        <div class="track-artist">
                            @string.Join(", ", trackObj.Artists.Select(a => a.Name))
                        </div>
                    </div>

                    <div class="track-duration">
                        @FormatTime(trackObj.DurationMs)
                    </div>
                </div>
            }
        </ul>
    }
</AnimatedPage>

@code {
    [Parameter] public string AlbumId { get; set; } = "";

    private SpotifyAlbum? album;
    private SpotifyArtist? artist;


    // --- INIT ---

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadAlbum();

            await Telemetry.TrackAsync(
                level: "Info",
                message: $"Album selected: {album?.Name}",
                context: $"Artist: {artist?.Name}",
                page: "AlbumPage",
                component: "AlbumDetails",
                action: "AlbumSelected"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadAlbum();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        // Playback changed elsewhere in the application.
        //
        // The album data itself has not changed, so there is no
        // need to make another Spotify API request here.

        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    // --- LOAD ALBUM ---

    private async Task LoadAlbum()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        album = await Auth.GetAlbumAsync(AlbumId);
        artist = album?.Artists?.FirstOrDefault();
    }


    // --- PLAYBACK ---

    private async Task Play(SpotifyTrack track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        // Determine track index inside album
        int index = album?.Tracks?.Items.FindIndex(t => t.Id == track.Id) ?? -1;

        if (index < 0)
            index = track.TrackNumber - 1;

        if (index < 0)
            index = 0;

        // Play inside album context
        // SpotifyAuthService will raise OnPlaybackChanged
        // after the playback request succeeds.
        await Auth.PlayTrackInContextAsync(album!.Uri, index);

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Track played: {track.Name}",
            context: $"Album: {album?.Name}, Artist: {artist?.Name}",
            page: "AlbumPage",
            component: "TrackList",
            action: "TrackPlayed"
        );
    }


    // --- HELPERS ---

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}