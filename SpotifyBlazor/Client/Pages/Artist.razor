@page "/artist/{ArtistId}"
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject NavigationManager Navigation

@if (artist == null)
{
    <p>Loading artist...</p>
}
else
{
    <div class="d-flex gap-4">

        <img src="@artist.Images.FirstOrDefault()?.Url"
             style="width:220px; border-radius:8px;" />

        <div>
            <h3>@artist.Name</h3>
            @if (artist.Followers != null)
            {
                <p><strong>Followers:</strong> @artist.Followers.Total</p>
            }

            @if (artist.Genres != null && artist.Genres.Any())
            {
                <p><strong>Genres:</strong> @string.Join(", ", artist.Genres)</p>
            }
        </div>
    </div>

    @if (albums != null && albums.Any())
{
    <h3 class="mt-4 mb-3">Albums</h3>

        <div class="album-wrap">
        @foreach (var album in albums)
        {
             var albumUrl = $"/album/{album.Id}?from=artist";

            
            <div class="album-item"
                     @onclick="() => Navigation.NavigateTo(albumUrl)">

                <img src="@album.Images.FirstOrDefault()?.Url"
                     alt="@album.Name"
                     class="album-cover-small" />

                <div class="album-title">@album.Name</div>
                <div class="album-date">@album.ReleaseDate</div>
            </div>
        }
    </div>
}
}

@code {
    [Parameter] public string ArtistId { get; set; }

    private SpotifyArtistFull? artist;
    private List<SpotifyAlbum>? albums;

    protected override async Task OnInitializedAsync()
    {
        artist = await Auth.GetArtistAsync(ArtistId);
        albums = await Auth.GetAllArtistAlbums(ArtistId);
    }

    private async Task Play(string uri)
    {
        await Auth.PlayTrackAsync(uri);
    }

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
