@page "/history"
@implements IDisposable

@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@inject NavigationManager Nav
@inject IJSRuntime JS

<AnimatedPage>

    <h2 class="page-title">Recently Played</h2>

    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to see your recently played tracks.</p>
        </div>
    }
    else if (_history == null)
    {
        <p class="page-message">Loading your recently played tracks…</p>
    }
    else if (_history.Items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🕒</div>
            <p>No recently played tracks found.</p>
        </div>
    }
    else
    {
        <div class="track-list">
            @foreach (var item in PagedItems.Where(i => i.Track != null))
            {
                <div class="track-row" @onclick="@(() => PlayTrack(item.Track))">

                    <div class="track-row-art">
                        <img src="@(item.Track.Album?.Images?.FirstOrDefault()?.Url ?? "")" alt="" />
                        <span class="track-row-play">▶</span>
                    </div>

                    <div class="track-row-info">
                        <div class="track-row-name">@item.Track.Name</div>
                        <div class="track-row-sub">
                            @foreach (var artist in item.Track.Artists ?? new List<SpotifyArtist>())
                            {
                                <span class="text-link"
                                      @onclick:stopPropagation="true"
                                      @onclick="@(() => OnArtistClicked(artist))">@artist.Name</span>
                                @if (artist != item.Track.Artists!.Last())
                                {
                                    <span>, </span>
                                }
                            }
                        </div>
                    </div>

                    @if (item.Track.Album != null)
                    {
                        <div class="track-row-album">
                            <span class="text-link"
                                  @onclick:stopPropagation="true"
                                  @onclick="@(() => OnAlbumClicked(item.Track))">@item.Track.Album.Name</span>
                        </div>
                    }

                    <div class="track-row-meta wide">@item.PlayedAt.ToLocalTime().ToString("g")</div>
                </div>
            }
        </div>

        <div class="pager">
            <button class="pill-btn"
                    disabled="@(CurrentPage == 0)"
                    @onclick="PrevPage">
                Previous
            </button>

            <button class="pill-btn"
                    disabled="@(CurrentPage >= TotalPages - 1)"
                    @onclick="NextPage">
                Next
            </button>

            <span class="pager-text">Page @(CurrentPage + 1) of @(Math.Max(1, TotalPages))</span>
        </div>
    }

</AnimatedPage>

@code {
    private SpotifyPlayHistory? _history;

    // --- PAGINATION ---
    private int PageSize = 20;
    private int CurrentPage = 0;

    private int TotalPages =>
        _history == null
            ? 1
            : (int)Math.Ceiling(_history.Items.Count / (double)PageSize);

    private IEnumerable<PlayHistoryItem> PagedItems =>
        _history?.Items
            .Skip(CurrentPage * PageSize)
            .Take(PageSize)
            ?? Enumerable.Empty<PlayHistoryItem>();


    // --- INIT ---
    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadHistory();

            await Telemetry.TrackAsync(
                level: "Info",
                message: "History page loaded",
                context: null,
                page: "HistoryPage",
                component: "HistoryList",
                action: "PageLoaded"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadHistory();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        // Playback changed elsewhere in the application.
        //
        // We intentionally don't reload the history here.
        // Playback events can happen frequently (play/pause/skip),
        // and Spotify's recently-played endpoint doesn't need to
        // be queried for every playback state change.

        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    // --- SCROLLING ---

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }


    // --- PAGINATION ---

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages - 1)
        {
            CurrentPage++;
            await ScrollToTop();
        }
    }

    private async Task PrevPage()
    {
        if (CurrentPage > 0)
        {
            CurrentPage--;
            await ScrollToTop();
        }
    }

    // --- LOAD HISTORY ---

    private async Task LoadHistory()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackTimedAsync(
            "Info",
            "History.LoadRecentlyPlayed",
            async () =>
            {
                _history = await Auth.GetRecentlyPlayedAsync();
            },
            context: "Fetching recently played tracks",
            page: "HistoryPage",
            component: "HistoryList",
            actionName: "LoadRecentlyPlayed"
        );
    }


    // --- ACTIONS ---

    private async Task PlayTrack(SpotifyTrack track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        // Determine track index inside its album
        int index = track.TrackNumber > 0
            ? track.TrackNumber - 1
            : 0;

        await Telemetry.TrackAsync(
            "Info",
            $"Track played: {track?.Name}",
            context: $"Artist: {string.Join(", ", track?.Artists?.Select(a => a.Name) ?? new List<string>())}",
            page: "HistoryPage",
            component: "TrackList",
            action: "TrackPlayed"
        );

        // Play inside album context (enables next/previous)
        await Auth.PlayTrackInContextAsync(track.Album.Uri, index);
    }

    private async Task OnAlbumClicked(SpotifyTrack track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackAsync(
            "Info",
            $"Album clicked: {track?.Album?.Name}",
            context: $"Artist: {string.Join(", ", track?.Artists?.Select(a => a.Name) ?? new List<string>())}",
            page: "HistoryPage",
            component: "AlbumLink",
            action: "AlbumClicked"
        );

        Nav.NavigateTo($"/album/{track?.Album?.Id}");
    }

    private async Task OnArtistClicked(SpotifyArtist artist)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackAsync(
            "Info",
            $"Artist clicked: {artist?.Name}",
            context: null,
            page: "HistoryPage",
            component: "ArtistLink",
            action: "ArtistClicked"
        );

        Nav.NavigateTo($"/artist/{artist.Id}");
    }
}