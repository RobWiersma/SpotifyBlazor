@page "/"

<PageTitle>SpotifyBlazor</PageTitle>

<AnimatedPage>
    <h2 class="page-title">Welcome to SpotifyBlazor</h2>

    <div class="card-grid">
        <a href="/liked" class="media-card">
            <div class="media-card-image media-card-placeholder">💚</div>
            <div class="media-card-title">Liked</div>
            <div class="media-card-subtitle">Songs, albums and podcasts</div>
        </a>

        <a href="/playlists" class="media-card">
            <div class="media-card-image media-card-placeholder">🎶</div>
            <div class="media-card-title">Playlists</div>
            <div class="media-card-subtitle">Your playlists</div>
        </a>

        <a href="/history" class="media-card">
            <div class="media-card-image media-card-placeholder">🕒</div>
            <div class="media-card-title">Recently Played</div>
            <div class="media-card-subtitle">Your play history</div>
        </a>
    </div>
</AnimatedPage>