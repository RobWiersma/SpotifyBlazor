@page "/liked"
@inject SpotifyAuthService Auth
@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject TelemetryService Telemetry
@inject NavigationManager Nav

<AnimatedPage>

    <h2 class="mb-3">Liked</h2>

    <!-- Tabs -->
    <ul class="nav nav-pills mb-4 liked-tabs">
        <li class="nav-item">
            <button class="nav-link @( _activeTab == "songs" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("songs"))>
                Songs
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link @( _activeTab == "albums" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("albums"))>
                Albums
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link @( _activeTab == "shows" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("shows"))>
                Podcasts
            </button>
        </li>
    </ul>

    <!-- SONGS TAB -->
    @if (_activeTab == "songs")
    {
        @RenderSongs()
    }

    <!-- ALBUMS TAB -->
    @if (_activeTab == "albums")
    {
        @RenderAlbums()
    }

    <!-- PODCASTS TAB -->
    @if (_activeTab == "shows")
    {
        @RenderShows()
    }

</AnimatedPage>

@code {
    // --- DATA ---
    private SpotifyLikedSongs? LikedSongs;
    private SpotifySavedAlbums? SavedAlbums;
    private SpotifySavedShows? SavedShows;

    private int _offset = 0;
    private int _limit = 50;

    private HashSet<string> _animatedTracks = new();

    private string _activeTab = "songs";

    // --- INIT ---
    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += async state =>
        {
            if (state == LoginState.LoggedIn)
            {
                await LoadAll();
                StateHasChanged();
            }
        };

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadAll();

            await Telemetry.TrackAsync(
                level: "Info",
                message: "Liked page loaded",
                context: $"Offset: {_offset}, Limit: {_limit}",
                page: "LikedPage",
                component: "LikedContent",
                action: "PageLoaded"
            );
        }
    }

    private async Task LoadAll()
    {
        await LoadLikedSongs();
        SavedAlbums = await Auth.GetSavedAlbumsAsync();
        SavedShows = await Auth.GetSavedShowsAsync();
    }

    // --- SONGS ---
    private async Task LoadLikedSongs()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        LikedSongs = await Auth.GetLikedSongsAsync(_offset, _limit);

        _animatedTracks = LikedSongs.Items
            .Select(i => i.Track?.Id)
            .Where(id => id != null)
            .ToHashSet();
    }

    private RenderFragment RenderSongs() => __builder =>
    {
        if (Auth.State != LoginState.LoggedIn)
        {
            __builder.AddContent(0, "You must be logged in to view your liked songs.");
            return;
        }

        if (LikedSongs == null)
        {
            __builder.AddContent(1, "Loading your liked songs…");
            return;
        }

        if (LikedSongs.Items.Count == 0)
        {
            __builder.AddContent(2, "You have no liked songs.");
            return;
        }

        <ul class="track-list">
            @foreach (var t in LikedSongs.Items)
            {
                <li class="track-item @( _animatedTracks.Contains(t.Track?.Id) ? "track-item-loaded" : "" )">

                    <div class="track-left">
                        <img src="@(t.Track?.Album?.Images?.FirstOrDefault()?.Url ?? "")"
                             class="track-cover"
                             style="cursor:pointer"
                             @onclick="@(() => OnAlbumClicked(t.Track))" />

                        <div class="track-info">

                            <div class="track-name"
                                 style="cursor:pointer"
                                 @onclick="@(() => PlayTrack(t.Track))">
                                @t.Track?.Name
                            </div>

                            <div class="track-artist">
                                @foreach (var artist in t.Track?.Artists ?? new List<SpotifyArtist>())
                                {
                                    <span class="artist-link"
                                          style="cursor:pointer; text-decoration:underline;"
                                          @onclick="@(() => OnArtistClicked(artist))">
                                        @artist.Name
                                    </span>

                                    @if (artist != t.Track.Artists.Last())
                                    {
                                        <span>, </span>
                                    }
                                }
                            </div>

                        </div>
                    </div>

                    <div class="track-duration">
                        @FormatDuration(t.Track?.DurationMs ?? 0)
                    </div>

                </li>
            }
        </ul>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-secondary" disabled="@(_offset == 0)" @onclick="PrevPage">Previous</button>
            <button class="btn btn-secondary" disabled="@(_offset + _limit >= LikedSongs.Total)" @onclick="NextPage">Next</button>
        </div>
    };

    // --- ALBUMS ---
    private RenderFragment RenderAlbums() => __builder =>
    {
        if (SavedAlbums == null)
        {
            __builder.AddContent(0, "Loading albums…");
            return;
        }

        if (SavedAlbums.Items.Count == 0)
        {
            __builder.AddContent(1, "You have no saved albums.");
            return;
        }

        foreach (var a in SavedAlbums.Items)
        {
            <div class="album-row mb-3 d-flex align-items-center"
                 style="cursor:pointer"
                 @onclick="@(() => Nav.NavigateTo($"/album/{a.Album.Id}"))">

                <img src="@a.Album.Images.FirstOrDefault()?.Url"
                     class="album-cover me-3"
                     style="width:64px; height:64px; border-radius:4px;" />

                <div>
                    <div class="fw-bold">@a.Album.Name</div>
                    <div>@a.Album.Artists.First().Name</div>
                </div>
            </div>
        }
    };

    // --- PODCASTS ---
    private RenderFragment RenderShows() => __builder =>
    {
        if (SavedShows == null)
        {
            __builder.AddContent(0, "Loading podcasts…");
            return;
        }

        if (SavedShows.Items.Count == 0)
        {
            __builder.AddContent(1, "You have no saved podcasts.");
            return;
        }

        foreach (var s in SavedShows.Items)
        {
            <div class="show-row mb-3 d-flex align-items-center"
                 style="cursor:pointer"
                 @onclick="@(() => Nav.NavigateTo($"/show/{s.Show.Id}"))">

                <img src="@s.Show.Images.FirstOrDefault()?.Url"
                     class="show-cover me-3"
                     style="width:64px; height:64px; border-radius:4px;" />

                <div>
                    <div class="fw-bold">@s.Show.Name</div>
                    <div>@s.Show.Publisher</div>
                </div>
            </div>
        }
    };

    // --- PAGINATION ---
    private async Task NextPage()
    {
        _offset += _limit;
        await LoadLikedSongs();

        await Telemetry.TrackAsync(
            "Info",
            "Liked Songs: Next page",
            context: $"Offset: {_offset}",
            page: "LikedPage",
            component: "Pagination",
            action: "NextPage"
        );
    }

    private async Task PrevPage()
    {
        _offset -= _limit;
        if (_offset < 0) _offset = 0;

        await LoadLikedSongs();

        await Telemetry.TrackAsync(
            "Info",
            "Liked Songs: Previous page",
            context: $"Offset: {_offset}",
            page: "LikedPage",
            component: "Pagination",
            action: "PreviousPage"
        );
    }

    // --- ACTIONS ---
    private async Task PlayTrack(SpotifyTrack track)
    {
        int index = LikedSongs.Items.FindIndex(i => i.Track.Id == track.Id);
        if (index < 0) index = 0;

        await Auth.PlayTrackInContextAsync("spotify:collection:tracks", index);
    }

    private async Task OnAlbumClicked(SpotifyTrack track)
    {
        Nav.NavigateTo($"/album/{track?.Album?.Id}");
    }

    private async Task OnArtistClicked(SpotifyArtist artist)
    {
        Nav.NavigateTo($"/artist/{artist.Id}");
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;

        Telemetry.TrackAsync(
            "Info",
            $"Liked tab switched: {tab}",
            context: null,
            page: "LikedPage",
            component: "TabSwitch",
            action: "TabChanged"
        );
    }

    private string FormatDuration(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
