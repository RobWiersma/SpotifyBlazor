@page "/liked"
@implements IDisposable

@inject SpotifyAuthService Auth
@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject TelemetryService Telemetry
@inject NavigationManager Nav

<AnimatedPage>

    <h2 class="page-title">Liked</h2>

    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to see your liked songs, albums and podcasts.</p>
        </div>
    }
    else
    {
        <!-- Tabs -->
        <div class="chips">
            <button class="chip @( _activeTab == "songs" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("songs"))>
                Songs
            </button>

            <button class="chip @( _activeTab == "albums" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("albums"))>
                Albums
            </button>

            <button class="chip @( _activeTab == "shows" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("shows"))>
                Podcasts
            </button>
        </div>

        <!-- SONGS TAB -->
        @if (_activeTab == "songs")
        {
            @RenderSongs()
        }

        <!-- ALBUMS TAB -->
        @if (_activeTab == "albums")
        {
            @RenderAlbums()
        }

        <!-- PODCASTS TAB -->
        @if (_activeTab == "shows")
        {
            @RenderShows()
        }
    }

</AnimatedPage>

@code {
    // --- DATA ---
    private SpotifyLikedSongs? LikedSongs;
    private SpotifySavedAlbums? SavedAlbums;
    private SpotifySavedShows? SavedShows;

    private int _offset = 0;
    private int _limit = 50;
    private bool _songsFailed;

    private string _activeTab = "songs";


    // --- INIT ---

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadAll();

            await Telemetry.TrackAsync(
                level: "Info",
                message: "Liked page loaded",
                context: $"Offset: {_offset}, Limit: {_limit}",
                page: "LikedPage",
                component: "LikedContent",
                action: "PageLoaded"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadAll();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        // Playback changed elsewhere in the application.
        // The liked list itself doesn't need to be reloaded,
        // but refresh the component in case we add playback
        // highlighting or other state-dependent UI later.

        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    private async Task LoadAll()
    {
        await LoadLikedSongs();
        SavedAlbums = await Auth.GetSavedAlbumsAsync();
        SavedShows = await Auth.GetSavedShowsAsync();
    }


    // --- SONGS ---

    private async Task LoadLikedSongs()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        _songsFailed = false;

        try
        {
            LikedSongs = await Auth.GetLikedSongsAsync(_offset, _limit);
        }
        catch
        {
            LikedSongs = null;
        }

        if (LikedSongs == null)
            _songsFailed = true;
    }

    private async Task RetryLikedSongs()
    {
        _songsFailed = false;
        await LoadLikedSongs();
    }


    private RenderFragment RenderSongs() => __builder =>
    {
        if (LikedSongs == null && _songsFailed)
        {
            <div class="empty-state">
                <p>Couldn't load your liked songs.</p>
                <button class="pill-btn" @onclick="RetryLikedSongs">Try again</button>
            </div>
            return;
        }

        if (LikedSongs == null)
        {
            <p class="page-message">Loading your liked songs…</p>
            return;
        }

        if (LikedSongs.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">💚</div>
                <p>You have no liked songs yet.</p>
            </div>
            return;
        }

        <div class="track-list">
            @foreach (var t in LikedSongs.Items.Where(i => i.Track != null))
            {
                <div class="track-row" @onclick="@(() => PlayTrack(t.Track))">

                    <div class="track-row-art">
                        <img src="@(t.Track.Album?.Images?.FirstOrDefault()?.Url ?? "")" alt="" />
                        <span class="track-row-play">▶</span>
                    </div>

                    <div class="track-row-info">
                        <div class="track-row-name">@t.Track.Name</div>
                        <div class="track-row-sub">
                            @foreach (var artist in t.Track.Artists ?? new List<SpotifyArtist>())
                            {
                                <span class="text-link"
                                      @onclick:stopPropagation="true"
                                      @onclick="@(() => OnArtistClicked(artist))">@artist.Name</span>
                                @if (artist != t.Track.Artists!.Last())
                                {
                                    <span>, </span>
                                }
                            }
                        </div>
                    </div>

                    @if (t.Track.Album != null)
                    {
                        <div class="track-row-album">
                            <span class="text-link"
                                  @onclick:stopPropagation="true"
                                  @onclick="@(() => OnAlbumClicked(t.Track))">@t.Track.Album.Name</span>
                        </div>
                    }

                    <div class="track-row-meta">@FormatDuration(t.Track.DurationMs)</div>
                </div>
            }
        </div>

        <div class="pager">
            <button class="pill-btn"
                    disabled="@(_offset == 0)"
                    @onclick="PrevPage">
                Previous
            </button>

            <button class="pill-btn"
                    disabled="@(_offset + _limit >= LikedSongs.Total)"
                    @onclick="NextPage">
                Next
            </button>

            <span class="pager-text">
                Page @(_offset / _limit + 1) of @(Math.Max(1, (int)Math.Ceiling(LikedSongs.Total / (double)_limit)))
            </span>
        </div>
    };


    // --- ALBUMS ---

    private RenderFragment RenderAlbums() => __builder =>
    {
        if (SavedAlbums == null)
        {
            <p class="page-message">Loading albums…</p>
            return;
        }

        if (SavedAlbums.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">💿</div>
                <p>You have no saved albums yet.</p>
            </div>
            return;
        }

        <div class="card-grid">
            @foreach (var a in SavedAlbums.Items)
            {
                <div class="media-card" @onclick="@(() => Nav.NavigateTo($"/album/{a.Album.Id}"))">
                    <img src="@a.Album.Images.FirstOrDefault()?.Url" class="media-card-image" alt="" />
                    <div class="media-card-title">@a.Album.Name</div>
                    <div class="media-card-subtitle">@a.Album.Artists.FirstOrDefault()?.Name</div>
                </div>
            }
        </div>
    };


    // --- PODCASTS ---

    private RenderFragment RenderShows() => __builder =>
    {
        if (SavedShows == null)
        {
            <p class="page-message">Loading podcasts…</p>
            return;
        }

        if (SavedShows.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🎙️</div>
                <p>You have no saved podcasts yet.</p>
            </div>
            return;
        }

        <div class="card-grid">
            @foreach (var s in SavedShows.Items)
            {
                <div class="media-card" @onclick="@(() => Nav.NavigateTo($"/show/{s.Show.Id}"))">
                    <img src="@s.Show.Images.FirstOrDefault()?.Url" class="media-card-image" alt="" />
                    <div class="media-card-title">@s.Show.Name</div>
                    <div class="media-card-subtitle">@s.Show.Publisher</div>
                </div>
            }
        </div>
    };


    // --- PAGINATION ---

    private async Task NextPage()
    {
        _offset += _limit;

        await LoadLikedSongs();

        await Telemetry.TrackAsync(
            "Info",
            "Liked Songs: Next page",
            context: $"Offset: {_offset}",
            page: "LikedPage",
            component: "Pagination",
            action: "NextPage"
        );
    }

    private async Task PrevPage()
    {
        _offset -= _limit;

        if (_offset < 0)
            _offset = 0;

        await LoadLikedSongs();

        await Telemetry.TrackAsync(
            "Info",
            "Liked Songs: Previous page",
            context: $"Offset: {_offset}",
            page: "LikedPage",
            component: "Pagination",
            action: "PreviousPage"
        );
    }


    // --- ACTIONS ---

    private async Task PlayTrack(SpotifyTrack track)
    {
        int index = LikedSongs?.Items.FindIndex(i => i.Track?.Id == track.Id) ?? -1;

        if (index < 0)
            index = 0;

        await Auth.PlayTrackInContextAsync(
            "spotify:collection:tracks",
            index);
    }

    private Task OnAlbumClicked(SpotifyTrack track)
    {
        Nav.NavigateTo($"/album/{track?.Album?.Id}");
        return Task.CompletedTask;
    }

    private Task OnArtistClicked(SpotifyArtist artist)
    {
        Nav.NavigateTo($"/artist/{artist.Id}");
        return Task.CompletedTask;
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;

        _ = Telemetry.TrackAsync(
            "Info",
            $"Liked tab switched: {tab}",
            context: null,
            page: "LikedPage",
            component: "TabSwitch",
            action: "TabChanged"
        );
    }

    private string FormatDuration(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}