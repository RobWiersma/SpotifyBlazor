@page "/liked"
@implements IDisposable

@inject SpotifyAuthService Auth
@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject TelemetryService Telemetry
@inject NavigationManager Nav

<AnimatedPage>

    <h2 class="page-title">Liked</h2>

    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to see your liked songs, albums and podcasts.</p>
        </div>
    }
    else
    {
        <!-- Tabs -->
        <div class="chips">
            <button class="chip @( _activeTab == "songs" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("songs"))>
                Songs
            </button>

            <button class="chip @( _activeTab == "albums" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("albums"))>
                Albums
            </button>

            <button class="chip @( _activeTab == "shows" ? "active" : "" )"
                    @onclick=@(() => SwitchTab("shows"))>
                Podcasts
            </button>
        </div>

        <!-- SONGS TAB -->
        @if (_activeTab == "songs")
        {
            <div class="track-toolbar">
                <LengthFilter Minutes="_minMinutes" MinutesChanged="OnMinLengthChanged" />
            </div>

            @if (_minMinutes > 0)
            {
                @RenderLongSongs()
            }
            else
            {
                @RenderSongs()
            }
        }

        <!-- ALBUMS TAB -->
        @if (_activeTab == "albums")
        {
            @RenderAlbums()
        }

        <!-- PODCASTS TAB -->
        @if (_activeTab == "shows")
        {
            @RenderShows()
        }
    }

</AnimatedPage>

@code {
    // --- DATA ---
    private SpotifyLikedSongs? LikedSongs;
    private SpotifySavedAlbums? SavedAlbums;
    private SpotifySavedShows? SavedShows;

    private int _offset = 0;
    private int _limit = 50;
    private bool _songsFailed;

    private string _activeTab = "songs";

    // --- "Longer than" filter ---
    // Liked songs come 50 at a time, so the filter looks through them in batches
    // and keeps each match's position for playing it in the Liked context.
    private const int LikedPageSize = 50;
    private const int ScanMatchesPerBatch = 20;
    private const int ScanPagesPerBatch = 10;   // up to 500 songs per batch

    private double _minMinutes;
    private readonly List<(LikedSongItem Item, int Index)> _longSongs = new();
    private int _scanned;
    private int _scanTotal = -1;    // -1 until Spotify has said how many liked songs there are
    private bool _scanning;
    private bool _scanFailed;
    private int _scanGeneration;    // bumped on every reset so an older scan stops

    private bool CanScanMore => _scanTotal < 0 || _scanned < _scanTotal;


    // --- INIT ---

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadAll();

            await Telemetry.TrackAsync(
                level: "Info",
                message: "Liked page loaded",
                context: $"Offset: {_offset}, Limit: {_limit}",
                page: "LikedPage",
                component: "LikedContent",
                action: "PageLoaded"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadAll();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        // Playback changed elsewhere in the application.
        // The liked list itself doesn't need to be reloaded,
        // but refresh the component in case we add playback
        // highlighting or other state-dependent UI later.

        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    private async Task LoadAll()
    {
        await LoadLikedSongs();
        SavedAlbums = await Auth.GetSavedAlbumsAsync();
        SavedShows = await Auth.GetSavedShowsAsync();
    }


    // --- SONGS ---

    private async Task LoadLikedSongs()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        _songsFailed = false;

        try
        {
            LikedSongs = await Auth.GetLikedSongsAsync(_offset, _limit);
        }
        catch
        {
            LikedSongs = null;
        }

        if (LikedSongs == null)
            _songsFailed = true;
    }

    private async Task RetryLikedSongs()
    {
        _songsFailed = false;
        await LoadLikedSongs();
    }


    private RenderFragment RenderSongs() => __builder =>
    {
        if (LikedSongs == null && _songsFailed)
        {
            <div class="empty-state">
                <p>Couldn't load your liked songs.</p>
                <button class="pill-btn" @onclick="RetryLikedSongs">Try again</button>
            </div>
            return;
        }

        if (LikedSongs == null)
        {
            <p class="page-message">Loading your liked songs…</p>
            return;
        }

        if (LikedSongs.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">💚</div>
                <p>You have no liked songs yet.</p>
            </div>
            return;
        }

        <div class="track-list">
            @foreach (var (t, i) in LikedSongs.Items.Select((t, i) => (t, i)).Where(x => x.t.Track != null))
            {
                @RenderSongRow(t, _offset + i)
            }
        </div>

        <div class="pager">
            <button class="pill-btn"
                    disabled="@(_offset == 0)"
                    @onclick="PrevPage">
                Previous
            </button>

            <button class="pill-btn"
                    disabled="@(_offset + _limit >= LikedSongs.Total)"
                    @onclick="NextPage">
                Next
            </button>

            <span class="pager-text">
                Page @(_offset / _limit + 1) of @(Math.Max(1, (int)Math.Ceiling(LikedSongs.Total / (double)_limit)))
            </span>
        </div>
    };


    private RenderFragment RenderSongRow(LikedSongItem t, int index) => __builder =>
    {
        <div class="track-row" @onclick="@(() => PlayAt(index))">

            <div class="track-row-art">
                <img src="@(t.Track.Album?.Images?.FirstOrDefault()?.Url ?? "")" alt="" />
                <span class="track-row-play">▶</span>
            </div>

            <div class="track-row-info">
                <div class="track-row-name">@t.Track.Name</div>
                <div class="track-row-sub">
                    @foreach (var artist in t.Track.Artists ?? new List<SpotifyArtist>())
                    {
                        <span class="text-link"
                              @onclick:stopPropagation="true"
                              @onclick="@(() => OnArtistClicked(artist))">@artist.Name</span>
                        @if (artist != t.Track.Artists!.Last())
                        {
                            <span>, </span>
                        }
                    }
                </div>
            </div>

            @if (t.Track.Album != null)
            {
                <div class="track-row-album">
                    <span class="text-link"
                          @onclick:stopPropagation="true"
                          @onclick="@(() => OnAlbumClicked(t.Track))">@t.Track.Album.Name</span>
                </div>
            }

            <div class="track-row-meta">@FormatDuration(t.Track.DurationMs)</div>
        </div>
    };

    private async Task OnMinLengthChanged(double minutes)
    {
        _minMinutes = minutes;

        _scanGeneration++;
        _longSongs.Clear();
        _scanned = 0;
        _scanTotal = -1;
        _scanning = false;
        _scanFailed = false;

        if (_minMinutes > 0)
            await ScanMoreAsync();
    }

    private async Task ScanMoreAsync()
    {
        if (_scanning || _minMinutes <= 0 || Auth.State != LoginState.LoggedIn)
            return;

        var generation = _scanGeneration;
        var found = 0;
        var pages = 0;

        _scanning = true;
        _scanFailed = false;
        StateHasChanged();

        try
        {
            while (found < ScanMatchesPerBatch && pages < ScanPagesPerBatch && CanScanMore)
            {
                var page = await Auth.GetLikedSongsAsync(_scanned, LikedPageSize);

                if (generation != _scanGeneration)
                    return;     // the filter changed meanwhile

                if (page == null)
                {
                    _scanFailed = true;
                    break;
                }

                pages++;
                _scanTotal = page.Total;

                for (var i = 0; i < page.Items.Count; i++)
                {
                    var item = page.Items[i];

                    if (item.Track != null && LengthFilter.Passes(item.Track.DurationMs, _minMinutes))
                    {
                        _longSongs.Add((item, _scanned + i));
                        found++;
                    }
                }

                _scanned += page.Items.Count;

                if (page.Items.Count == 0)
                {
                    _scanTotal = _scanned;  // Spotify ran out before its own count
                    break;
                }

                StateHasChanged();
            }
        }
        catch
        {
            if (generation == _scanGeneration)
                _scanFailed = true;
        }
        finally
        {
            if (generation == _scanGeneration)
            {
                _scanning = false;
                StateHasChanged();
            }
        }
    }

    private RenderFragment RenderLongSongs() => __builder =>
    {
        <p class="length-filter-status">
            @if (_scanning)
            {
                <span>Looking through your liked songs… @_longSongs.Count longer than @_minMinutes min in the first @_scanned so far</span>
            }
            else if (_scanFailed)
            {
                <span>Stopped early. @_longSongs.Count songs found in the first @_scanned liked songs.</span>
            }
            else if (CanScanMore)
            {
                <span>@_longSongs.Count songs longer than @_minMinutes min in the first @_scanned of @_scanTotal liked songs</span>
            }
            else
            {
                <span>@_longSongs.Count of your @_scanTotal liked songs are longer than @_minMinutes min</span>
            }
        </p>

        @if (_longSongs.Any())
        {
            <div class="track-list">
                @foreach (var (t, index) in _longSongs)
                {
                    @RenderSongRow(t, index)
                }
            </div>
        }
        else if (!_scanning)
        {
            <div class="empty-state">
                <div class="empty-state-icon">⏱️</div>
                <p>No liked songs longer than @_minMinutes min found@(CanScanMore ? " yet" : "").</p>
            </div>
        }

        @if (!_scanning && (CanScanMore || _scanFailed))
        {
            <div class="length-filter-more">
                <button class="pill-btn" @onclick="ScanMoreAsync">@(_scanFailed ? "Try again" : "Look further")</button>
            </div>
        }
    };


    // --- ALBUMS ---

    private RenderFragment RenderAlbums() => __builder =>
    {
        if (SavedAlbums == null)
        {
            <p class="page-message">Loading albums…</p>
            return;
        }

        if (SavedAlbums.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">💿</div>
                <p>You have no saved albums yet.</p>
            </div>
            return;
        }

        <div class="card-grid">
            @foreach (var a in SavedAlbums.Items)
            {
                <div class="media-card" @onclick="@(() => Nav.NavigateTo($"/album/{a.Album.Id}"))">
                    <img src="@a.Album.Images.FirstOrDefault()?.Url" class="media-card-image" alt="" />
                    <div class="media-card-title">@a.Album.Name</div>
                    <div class="media-card-subtitle">@a.Album.Artists.FirstOrDefault()?.Name</div>
                </div>
            }
        </div>
    };


    // --- PODCASTS ---

    private RenderFragment RenderShows() => __builder =>
    {
        if (SavedShows == null)
        {
            <p class="page-message">Loading podcasts…</p>
            return;
        }

        if (SavedShows.Items.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🎙️</div>
                <p>You have no saved podcasts yet.</p>
            </div>
            return;
        }

        <div class="card-grid">
            @foreach (var s in SavedShows.Items)
            {
                <div class="media-card" @onclick="@(() => Nav.NavigateTo($"/show/{s.Show.Id}"))">
                    <img src="@s.Show.Images.FirstOrDefault()?.Url" class="media-card-image" alt="" />
                    <div class="media-card-title">@s.Show.Name</div>
                    <div class="media-card-subtitle">@s.Show.Publisher</div>
                </div>
            }
        </div>
    };


    // --- PAGINATION ---

    private async Task NextPage()
    {
        _offset += _limit;

        await LoadLikedSongs();

        await Telemetry.TrackAsync(
            "Info",
            "Liked Songs: Next page",
            context: $"Offset: {_offset}",
            page: "LikedPage",
            component: "Pagination",
            action: "NextPage"
        );
    }

    private async Task PrevPage()
    {
        _offset -= _limit;

        if (_offset < 0)
            _offset = 0;

        await LoadLikedSongs();

        await Telemetry.TrackAsync(
            "Info",
            "Liked Songs: Previous page",
            context: $"Offset: {_offset}",
            page: "LikedPage",
            component: "Pagination",
            action: "PreviousPage"
        );
    }


    // --- ACTIONS ---

    // index is the song's position within all liked songs, not just this page
    private async Task PlayAt(int index)
    {
        await Auth.PlayTrackInContextAsync(
            await Auth.GetLikedSongsContextUriAsync(),
            index);
    }

    private Task OnAlbumClicked(SpotifyTrack track)
    {
        Nav.NavigateTo($"/album/{track?.Album?.Id}");
        return Task.CompletedTask;
    }

    private Task OnArtistClicked(SpotifyArtist artist)
    {
        Nav.NavigateTo($"/artist/{artist.Id}");
        return Task.CompletedTask;
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;

        _ = Telemetry.TrackAsync(
            "Info",
            $"Liked tab switched: {tab}",
            context: null,
            page: "LikedPage",
            component: "TabSwitch",
            action: "TabChanged"
        );
    }

    private string FormatDuration(int ms) => LengthFilter.Format(ms);
}