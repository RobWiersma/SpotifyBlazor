@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@page "/nowplaying"
@implements IDisposable
@inject SpotifyAuthService Auth
@inject NavigationManager Nav
@inject TelemetryService Telemetry
@inject IJSRuntime JS
@inject HttpClient Http
@inject NotificationService Notifications


<AnimatedPage>
    @if (_nowPlaying == null)
    {
        <div class="np-loading">Loading…</div>
    }
    else
    {
        <div class="np-container">

            <!-- Background -->
            <div class="np-bg" style="background-image:url('@AlbumImage');"></div>

            <!-- Visualizer: drawn by visualizer.js between the background and the content -->
            @if (_showVisualizer)
            {
                <canvas class="np-visualizer" @ref="_visualizerCanvas"></canvas>
            }

            <!-- Foreground -->
            <div class="np-content">

                <!-- Art -->
                <img src="@AlbumImage"
                     class="np-art @(_artLoaded ? "np-art-loaded" : "")" />

                <!-- Track info -->
                <div class="np-track-info">
                    <h1>@_nowPlaying.Item.Name</h1>
                    <h3>@string.Join(", ", _nowPlaying.Item.Artists.Select(a => a.Name))</h3>
                </div>

                <!-- Progress -->
                <div class="np-progress">
                    <div class="np-progress-bar-bg">
                        <div class="np-progress-bar-fill" style="width:@ProgressPercent%"></div>
                    </div>

                    <div class="np-progress-times">
                        <span>@FormatTime(_nowPlaying.ProgressMs)</span>
                        <span>@FormatTime(_nowPlaying.Item.DurationMs)</span>
                    </div>
                </div>

                <!-- Controls -->
                <div class="np-controls">
                    <button class="np-btn" @onclick="PrevTrack">⏮</button>
                    <button class="np-btn" @onclick="TogglePlayPause">
                        @(_nowPlaying.IsPlaying ? "⏸" : "▶️")
                    </button>
                    <button class="np-btn" @onclick="NextTrack">⏭</button>
                </div>

                <!-- Lyrics and video toggles -->
                <div class="np-lyrics-toggle">
                    <button class="np-btn" @onclick="ToggleLyrics">🎤 Lyrics</button>
                    <button class="np-btn" @onclick="ShowVideo">🎬 Video</button>
                    <button class="np-btn @(_showVisualizer ? "np-btn-on" : "")" @onclick="ToggleVisualizer">🌈 Visualizer</button>
                    @if (_showVisualizer)
                    {
                        <button class="np-btn @(_micOn ? "np-btn-on" : "")" @onclick="ToggleMic"
                                title="Make the visualizer react to what your microphone hears">🎙️ Mic</button>
                    }
                </div>

                <!-- Navigation -->
                <div class="np-links">
                    <span class="np-link" @onclick="GoToAlbum">View Album</span>
                    <span class="np-link" @onclick="GoToArtist">View Artist</span>
                </div>

            </div>

            <!-- Lyrics panel -->
            @if (_showLyrics)
            {
                <div class="lyrics-overlay" @onclick="HideLyrics"></div>

                <div class="lyrics-panel @(_lyricsReady ? "lyrics-loaded" : "")"
                     @ref="_lyricsPanelRef"
                     @onclick:stopPropagation>

                    <div class="lyrics-close" @onclick="HideLyrics">✕</div>

                    @if (_timedLyrics.Count > 0)
                    {
                        @foreach (var line in _timedLyrics.Select((l, i) => new { l, i }))
                        {
                            <div class="lyrics-line @(line.i == _currentLineIndex ? "active-line" : "")">
                                @line.l.Text
                            </div>
                        }
                    }
                    else if (_rawLyrics != null)
                    {
                        <pre class="lyrics-text">@_rawLyrics</pre>
                    }
                    else
                    {
                        <div class="lyrics-loading">Loading lyrics…</div>
                    }
                </div>
            }

            <!-- Music video panel -->
            @if (_showVideo)
            {
                <div class="video-overlay" @onclick="HideVideo"></div>

                <div class="video-panel" @onclick:stopPropagation>
                    <div class="lyrics-close" @onclick="HideVideo">✕</div>

                    @if (_video is { Videos.Count: > 0 } && _videosBlocked)
                    {
                        <!-- Every result blocks other sites; youtube.com itself can still play them -->
                        <div class="video-blocked">
                            <div>The video's owner only allows it to play on YouTube.</div>
                            <a class="np-btn" target="_blank" rel="noopener"
                               href="https://www.youtube.com/watch?v=@_video.Videos[0].VideoId">▶ Watch on YouTube</a>
                            <div class="video-caption">@_video.Videos[0].Title · @_video.Videos[0].Channel</div>
                        </div>
                    }
                    else if (_video is { Videos.Count: > 0 })
                    {
                        var current = _video.Videos[_videoIndex];

                        <!-- youtube-nocookie: YouTube's privacy-enhanced embed, no tracking cookies until play.
                             src stays on the first result; videoplayer.js swaps videos inside the player.
                             enablejsapi lets videoplayer.js hear playback errors. YouTube refuses embeds
                             whose request has no referrer (error 153), so send the site's origin. -->
                        <div class="video-frame">
                            <iframe @ref="_videoFrameRef"
                                    src="https://www.youtube-nocookie.com/embed/@_video.Videos[0].VideoId?autoplay=1&rel=0&enablejsapi=1&origin=@Uri.EscapeDataString(SiteOrigin)"
                                    title="@current.Title"
                                    referrerpolicy="strict-origin-when-cross-origin"
                                    allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                                    allowfullscreen></iframe>
                        </div>
                        <div class="video-caption">@current.Title · @current.Channel</div>
                    }
                    else
                    {
                        <div class="lyrics-loading">@(_videoMessage ?? "Finding the video…")</div>
                    }
                </div>
            }

        </div>
    }
</AnimatedPage>

@code {
    private SpotifyPlayerState? _nowPlaying;
    private bool _artLoaded;

    // lyrics state
    private bool _showLyrics;
    private bool _lyricsReady;
    private string? _rawLyrics;
    private readonly List<TimedLine> _timedLyrics = new();
    private int _currentLineIndex = -1;
    private string? _lyricsTrackId; // song the lyrics were loaded for
    private ElementReference _lyricsPanelRef;
    private IJSObjectReference? _lyricsModule;

    // video state
    private bool _showVideo;
    private VideoLookup? _video;
    private int _videoIndex;         // which search result is playing
    private bool _videosBlocked;     // every result refused to play here
    private bool _attachVideoPlayer; // a new iframe is rendering; hook videoplayer.js up after render
    private string? _videoMessage;
    private bool _pausedForVideo; // resume Spotify on close only if we paused it
    private ElementReference _videoFrameRef;
    private IJSObjectReference? _videoModule;
    private DotNetObjectReference<NowPlaying>? _videoCallbacks;

    private string SiteOrigin => Nav.BaseUri.TrimEnd('/');

    // visualizer state
    private bool _showVisualizer;
    private bool _visualizerRunning;
    private bool _micWanted; // saved choice: use the mic whenever the visualizer runs
    private bool _micOn;     // the mic is actually being listened to
    private string? _visualizerSentState; // last state sent to visualizer.js, to skip repeat updates
    private ElementReference _visualizerCanvas;
    private IJSObjectReference? _visualizerModule;


    private int _apiCounter;

    // Where Spotify said playback was, and when; the refresh loop counts on from there
    private int _progressAtSync;
    private DateTime _progressSyncedAt;

    private const int LyricsLeadMs = 300;

    // Stops the refresh loop when leaving the page; otherwise each visit leaks
    // a loop that keeps polling Spotify and eats into the app's rate limit.
    private readonly CancellationTokenSource _refreshCts = new();

    private string AlbumImage =>
        _nowPlaying?.Item?.Album?.Images?.FirstOrDefault()?.Url ?? "";

    private double ProgressPercent =>
        _nowPlaying?.Item == null
            ? 0
            : (double)_nowPlaying.ProgressMs / _nowPlaying.Item.DurationMs * 100;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.State == LoginState.LoggedIn)
            await ReloadNowPlaying();

        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        await Telemetry.TrackAsync(
            "Info",
            $"Now Playing opened: {_nowPlaying?.Item?.Name}",
            context: $"Artist: {string.Join(", ", _nowPlaying?.Item?.Artists?.Select(a => a.Name) ?? new List<string>())}",
            page: "NowPlayingPage",
            component: "NowPlaying",
            action: "PageLoaded"
        );
    }

    public void Dispose()
    {
        _refreshCts.Cancel();
        _refreshCts.Dispose();

        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;

        _videoCallbacks?.Dispose();

        // The animation loop would keep running on the removed canvas
        if (_visualizerRunning)
            _ = _visualizerModule!.InvokeVoidAsync("stop");
    }

    private async Task HandlePlaybackChangedAsync()
    {
        await ReloadNowPlaying();
        await EnsureLyricsAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await ReloadNowPlaying();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HideLyrics()
    {
        _showLyrics = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _lyricsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/lyrics.js");
            _ = RefreshLoop(_refreshCts.Token);

            _visualizerModule = await JS.InvokeAsync<IJSObjectReference>("import", "/visualizer.js");
            _showVisualizer = await _visualizerModule.InvokeAsync<bool>("isEnabled", "visualizer");
            _micWanted = await _visualizerModule.InvokeAsync<bool>("isEnabled", "visualizer-mic");
            if (_showVisualizer)
                StateHasChanged(); // renders the canvas; the next render starts it
        }

        await SyncVisualizerAsync();

        if (_attachVideoPlayer && _video is { Videos.Count: > 0 })
        {
            _attachVideoPlayer = false;
            _videoModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/videoplayer.js");
            _videoCallbacks ??= DotNetObjectReference.Create(this);

            await _videoModule.InvokeVoidAsync("attach",
                _videoFrameRef, _video.Videos.Select(v => v.VideoId).ToArray(), _videoCallbacks);
        }
    }

    // Starts, stops or updates visualizer.js to match the page. Runs after every render
    // (the refresh loop renders each second), but only calls into JS when something changed.
    private async Task SyncVisualizerAsync()
    {
        if (_visualizerModule == null)
            return;

        // The canvas ref has no Id until a render has actually drawn the canvas
        var canDraw = _showVisualizer && _nowPlaying != null && !string.IsNullOrEmpty(_visualizerCanvas.Id);

        if (!canDraw)
        {
            if (_visualizerRunning)
            {
                _visualizerRunning = false;
                _visualizerSentState = null;
                _micOn = false; // stop() releases the mic
                await _visualizerModule.InvokeVoidAsync("stop");
            }
            return;
        }

        var options = new
        {
            imageUrl = AlbumImage,
            playing = _nowPlaying!.IsPlaying,
            trackId = _nowPlaying.Item?.Id
        };

        if (!_visualizerRunning)
        {
            _visualizerRunning = true;
            _visualizerSentState = options.ToString();
            await _visualizerModule.InvokeVoidAsync("start", _visualizerCanvas, options);

            if (_micWanted)
                await SetMicAsync(true);
        }
        else if (options.ToString() != _visualizerSentState)
        {
            _visualizerSentState = options.ToString();
            await _visualizerModule.InvokeVoidAsync("update", options);
        }
    }

    private async Task ToggleVisualizer()
    {
        _showVisualizer = !_showVisualizer;

        if (_visualizerModule != null)
            await _visualizerModule.InvokeVoidAsync("setEnabled", _showVisualizer);
    }

    private async Task ToggleMic()
    {
        _micWanted = !_micOn;
        await _visualizerModule!.InvokeVoidAsync("setEnabled", _micWanted, "visualizer-mic");
        await SetMicAsync(_micWanted);
    }

    private async Task SetMicAsync(bool on)
    {
        var result = await _visualizerModule!.InvokeAsync<string>("setMic", on);
        _micOn = result == "on";

        if (result is "denied" or "unavailable")
        {
            // Don't ask again on every visit
            _micWanted = false;
            await _visualizerModule.InvokeVoidAsync("setEnabled", false, "visualizer-mic");

            Notifications.ShowWarning("Microphone not available",
                result == "denied"
                    ? "Firefox blocked the microphone. Allow it from the icon in the address bar, then click 🎙️ Mic again."
                    : "No microphone was found. The visualizer is using its built-in animation.",
                key: "visualizer|mic");
        }

        StateHasChanged();
    }

    // Called by videoplayer.js when a result won't play and it moves to the next one
    [JSInvokable]
    public void OnVideoChanged(int index)
    {
        if (_video == null || index >= _video.Videos.Count)
            return;

        _videoIndex = index;
        StateHasChanged();
    }

    // Called by videoplayer.js when none of the results will play outside youtube.com
    [JSInvokable]
    public void OnAllVideosBlocked()
    {
        _videosBlocked = true;
        StateHasChanged();
    }

    private async Task RefreshLoop(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            // Ticks 4x a second so lyric lines change on time; Spotify is still only asked every 10s
            try
            {
                await Task.Delay(250, token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            // Position = Spotify's last reported position + time since then, from the clock
            // (adding a fixed step per tick drifts, since Task.Delay always runs a little long)
            if (_nowPlaying?.IsPlaying == true && _nowPlaying.Item != null)
            {
                var elapsed = (int)(DateTime.UtcNow - _progressSyncedAt).TotalMilliseconds;
                _nowPlaying.ProgressMs = Math.Min(_progressAtSync + elapsed, _nowPlaying.Item.DurationMs);
            }

            _apiCounter++;
            if (_apiCounter >= 40)
            {
                _apiCounter = 0;
                await ReloadNowPlaying();
                await EnsureLyricsAsync();
            }

            if (_timedLyrics.Count > 0 && _nowPlaying != null)
            {
                // Light the line up just before it's sung, which reads as in time
                var currentTime = TimeSpan.FromMilliseconds(_nowPlaying.ProgressMs + LyricsLeadMs);

                var index = _timedLyrics.FindLastIndex(l => l.Time <= currentTime);
                if (index != _currentLineIndex)
                {
                    _currentLineIndex = index;
                    await ScrollLyricsToCurrentAsync();
                }
            }

            StateHasChanged();
        }
    }

    private async Task ScrollLyricsToCurrentAsync()
    {
        if (_currentLineIndex < 0 || _currentLineIndex >= _timedLyrics.Count)
            return;

        if (_lyricsModule != null)
        {
            await _lyricsModule.InvokeVoidAsync(
                "scrollLyricsToLine",
                _lyricsPanelRef,
                _currentLineIndex
            );
        }
    }

    private async Task ReloadNowPlaying()
    {
        _nowPlaying = await Auth.GetNowPlayingAsync();
        _progressAtSync = _nowPlaying?.ProgressMs ?? 0;
        _progressSyncedAt = DateTime.UtcNow;
        _artLoaded = true;
    }

    private async Task PrevTrack()
    {
        await Auth.SkipToPreviousAsync();
    }

    private async Task NextTrack()
    {
        await Auth.SkipToNextAsync();
    }

    private async Task TogglePlayPause()
    {
        if (_nowPlaying?.IsPlaying == true)
            await Auth.PauseAsync();
        else
            await Auth.PlayAsync();

    }

    private void GoToAlbum()
    {
        var id = _nowPlaying?.Item?.Album?.Id;
        if (id != null)
            Nav.NavigateTo($"/album/{id}");
    }

    private void GoToArtist()
    {
        var id = _nowPlaying?.Item?.Artists?.FirstOrDefault()?.Id;
        if (id != null)
            Nav.NavigateTo($"/artist/{id}");
    }

    private async Task ToggleLyrics()
    {
        _showLyrics = !_showLyrics;

        // Re-scroll to the current line when the panel opens again
        _currentLineIndex = -1;
        await EnsureLyricsAsync();
    }

    // Loads lyrics when the panel is open and the song changed since the last load.
    // (Reloading on every 10-second refresh used to reset the panel mid-song.)
    private async Task EnsureLyricsAsync()
    {
        var trackId = _nowPlaying?.Item?.Id;
        if (!_showLyrics || trackId == null || trackId == _lyricsTrackId)
            return;

        _lyricsTrackId = trackId;
        await LoadLyricsAsync();
    }

    // Timed lyrics from LRCLIB (lrclib.net): free, no key, and allows browser calls.
    // The old source (lyrics.ovh) has no timestamps, so lines were guessed at 3 seconds each.
    private async Task LoadLyricsAsync()
    {
        _lyricsReady = false;
        _rawLyrics = null;
        _timedLyrics.Clear();
        _currentLineIndex = -1;

        var item = _nowPlaying?.Item;
        var title = item?.Name;
        var artist = item?.Artists?.FirstOrDefault()?.Name;

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(artist))
        {
            _rawLyrics = "Lyrics not available.";
            _lyricsReady = true;
            return;
        }

        try
        {
            // A plain HttpClient: a missing song is normal here and shouldn't pop an error toast
            using var http = new HttpClient();

            // Exact match first: album and duration (within a couple of seconds) pick the right version
            var exactUrl = "https://lrclib.net/api/get" +
                $"?artist_name={Uri.EscapeDataString(artist)}" +
                $"&track_name={Uri.EscapeDataString(title)}" +
                $"&album_name={Uri.EscapeDataString(item!.Album?.Name ?? "")}" +
                $"&duration={item.DurationMs / 1000}";

            var response = await http.GetAsync(exactUrl);
            var lyrics = response.IsSuccessStatusCode
                ? await response.Content.ReadFromJsonAsync<LrcLibLyrics>()
                : null;

            // No exact match (live, remastered and deluxe versions often differ): search instead,
            // preferring a result that has timestamps and is close in length
            if (lyrics == null)
            {
                var searchUrl = "https://lrclib.net/api/search" +
                    $"?artist_name={Uri.EscapeDataString(artist)}" +
                    $"&track_name={Uri.EscapeDataString(title)}";

                var results = await http.GetFromJsonAsync<List<LrcLibLyrics>>(searchUrl) ?? new();
                lyrics = results
                    .OrderByDescending(r => !string.IsNullOrWhiteSpace(r.SyncedLyrics))
                    .ThenBy(r => Math.Abs(r.Duration - item.DurationMs / 1000.0))
                    .FirstOrDefault();
            }

            // A different-length version (e.g. studio cut of a live track) would be timed wrong
            var sameVersion = lyrics != null && Math.Abs(lyrics.Duration - item.DurationMs / 1000.0) <= 10;

            if (lyrics?.Instrumental == true)
                _rawLyrics = "♪ Instrumental ♪";
            else if (sameVersion && !string.IsNullOrWhiteSpace(lyrics?.SyncedLyrics))
                ParseSyncedLyrics(lyrics.SyncedLyrics);
            else if (!string.IsNullOrWhiteSpace(lyrics?.PlainLyrics))
                _rawLyrics = lyrics.PlainLyrics; // no timestamps: show it all rather than guess
            else
                _rawLyrics = "Lyrics not found.";
        }
        catch
        {
            _rawLyrics = "Unable to load lyrics.";
        }

        _lyricsReady = true;
        StateHasChanged();
    }

    // LRC format: one "[mm:ss.xx] text" per line. Empty text marks an instrumental gap.
    private void ParseSyncedLyrics(string lrc)
    {
        foreach (var line in lrc.Split('\n'))
        {
            var match = System.Text.RegularExpressions.Regex.Match(
                line, @"^\[(\d+):(\d+(?:\.\d+)?)\]\s*(.*)$");

            if (!match.Success)
                continue;

            var minutes = int.Parse(match.Groups[1].Value);
            var seconds = double.Parse(match.Groups[2].Value, System.Globalization.CultureInfo.InvariantCulture);
            var text = match.Groups[3].Value.Trim();

            _timedLyrics.Add(new TimedLine
            {
                Time = TimeSpan.FromMinutes(minutes) + TimeSpan.FromSeconds(seconds),
                Text = text.Length > 0 ? text : "♪"
            });
        }
    }

    private async Task ShowVideo()
    {
        var title = _nowPlaying?.Item?.Name;
        var artist = _nowPlaying?.Item?.Artists?.FirstOrDefault()?.Name;
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(artist))
            return;

        _showLyrics = false;
        _showVideo = true;
        _video = null;
        _videoIndex = 0;
        _videosBlocked = false;
        _videoMessage = null;

        // Start loading YouTube's player API now, alongside the search
        _videoModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/videoplayer.js");
        var apiLoading = _videoModule.InvokeVoidAsync("loadApi").AsTask();

        // Stop Spotify so the two don't play over each other
        if (_nowPlaying?.IsPlaying == true)
        {
            await Auth.PauseAsync();
            _nowPlaying.IsPlaying = false;
            _pausedForVideo = true;
        }

        try
        {
            // Failures already show a toast (ErrorNotificationHandler); the panel just says so too
            var response = await Http.GetAsync(
                $"/api/video?artist={Uri.EscapeDataString(artist)}&track={Uri.EscapeDataString(title)}");

            if (!response.IsSuccessStatusCode)
                _videoMessage = "Couldn't look up the video.";
            else
            {
                var video = await response.Content.ReadFromJsonAsync<VideoLookup>();
                if (video is not { Videos.Count: > 0 })
                    _videoMessage = "No music video found for this song.";
                else
                {
                    // Without the API (blocked by an extension, say) the first video still plays,
                    // just with no skipping past blocked ones
                    try
                    {
                        await apiLoading;
                        _attachVideoPlayer = true;
                    }
                    catch (JSException) { }

                    _video = video;
                }
            }
        }
        catch
        {
            _videoMessage = "Couldn't look up the video.";
        }

        await Telemetry.TrackAsync(
            "Info",
            $"Music video opened: {title}",
            context: _video?.Videos.FirstOrDefault()?.VideoId ?? _videoMessage,
            page: "NowPlayingPage",
            component: "NowPlaying",
            action: "VideoOpened"
        );
    }

    private async Task HideVideo()
    {
        // Removing the iframe stops the video
        _showVideo = false;
        _video = null;

        if (_pausedForVideo)
        {
            _pausedForVideo = false;
            await Auth.PlayAsync();
        }
    }

    private class LrcLibLyrics
    {
        public double Duration { get; set; }
        public bool Instrumental { get; set; }
        public string? PlainLyrics { get; set; }
        public string? SyncedLyrics { get; set; }
    }

    private class TimedLine
    {
        public TimeSpan Time { get; set; }
        public string Text { get; set; } = "";
    }

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }


}
