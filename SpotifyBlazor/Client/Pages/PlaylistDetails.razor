@page "/playlist/{PlaylistId}"
@implements IDisposable

@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject NavigationManager Nav
@inject TelemetryService Telemetry

<AnimatedPage>

    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to view this playlist.</p>
        </div>
    }
    else if (Playlist == null)
    {
        <p class="page-message">Loading playlist…</p>
    }
    else
    {
        <div class="media-header">
            <img src="@Playlist.Images?.FirstOrDefault()?.Url"
                 class="media-header-cover" alt="" />

            <div class="media-header-info">
                <div class="media-header-kicker">Playlist</div>
                <h1 class="media-header-title">@Playlist.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Playlist.Description))
                {
                    <p class="media-header-desc">@Playlist.Description</p>
                }
                <div class="media-header-meta">@Playlist.Owner?.DisplayName • @Tracks.Count songs</div>
            </div>
        </div>

        <div class="track-list">
            @foreach (var t in Tracks.Where(i => i.Track != null))
            {
                <div class="track-row" @onclick="@(() => PlayTrack(t))">

                    <div class="track-row-art">
                        <img src="@(t.Track!.Album?.Images?.FirstOrDefault()?.Url ?? "")" alt="" />
                        <span class="track-row-play">▶</span>
                    </div>

                    <div class="track-row-info">
                        <div class="track-row-name">@t.Track.Name</div>
                        <div class="track-row-sub">
                            @foreach (var artist in t.Track.Artists ?? new List<SimpleArtist>())
                            {
                                <span class="text-link"
                                      @onclick:stopPropagation="true"
                                      @onclick="@(() => OnArtistClicked(artist))">@artist.Name</span>
                                @if (artist != t.Track.Artists!.Last())
                                {
                                    <span>, </span>
                                }
                            }
                        </div>
                    </div>

                    @if (t.Track.Album != null)
                    {
                        <div class="track-row-album">
                            <span class="text-link"
                                  @onclick:stopPropagation="true"
                                  @onclick="@(() => OnAlbumClicked(t.Track))">@t.Track.Album.Name</span>
                        </div>
                    }

                    <button class="like-btn"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavorite(t.Track)"
                            title="@(_favoriteTracks.Contains(t.Track.Id ?? "") ? "Remove from Liked Songs" : "Add to Liked Songs")">
                        @(_favoriteTracks.Contains(t.Track.Id ?? "") ? "💚" : "➕")
                    </button>

                    <div class="track-row-meta">@FormatDuration(t.Track.DurationMs)</div>
                </div>
            }
        </div>
    }

</AnimatedPage>

@code {
    [Parameter] public string PlaylistId { get; set; } = "";

    public SpotifyPlaylist? Playlist { get; set; }
    public List<PlaylistTrackItem> Tracks { get; set; } = new();

    private HashSet<string> _favoriteTracks = new();


    // --- INIT ---

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadPlaylist();

            await Telemetry.TrackAsync(
                level: "Info",
                message: $"Playlist loaded: {Playlist?.Name}",
                context: $"Owner: {Playlist?.Owner?.DisplayName}, Tracks: {Tracks?.Count}",
                page: "PlaylistDetailsPage",
                component: "PlaylistHeader",
                action: "PlaylistLoaded"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadPlaylist();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        // Playback changed elsewhere in the application.
        //
        // The playlist data itself hasn't changed, so don't
        // make another Spotify API request here.

        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    // --- LOAD PLAYLIST ---

    private async Task LoadPlaylist()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        Playlist = await Auth.GetPlaylistAsync(PlaylistId);
        Tracks = await Auth.GetPlaylistTracksAsync(PlaylistId);

        await LoadFavoriteStates();
    }


    // --- FAVORITE STATES ---

    private async Task LoadFavoriteStates()
    {
        _favoriteTracks.Clear();

        var tracks = Tracks
            .Where(t => t.Track != null && !string.IsNullOrEmpty(t.Track.Id))
            .Select(t => t.Track!)
            .ToList();

        if (tracks.Count == 0)
            return;

        var uris = tracks
            .Select(t => $"spotify:track:{t.Id}")
            .ToList();

        var results = await Auth.AreFavoritesAsync(uris);

        for (int i = 0; i < tracks.Count && i < results.Length; i++)
        {
            if (results[i])
                _favoriteTracks.Add(tracks[i].Id);
        }
    }


    // --- FAVORITES ---

    private async Task ToggleFavorite(PlaylistTrack? track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        if (track == null || string.IsNullOrEmpty(track.Id))
            return;

        string uri = $"spotify:track:{track.Id}";

        bool isFavorite = _favoriteTracks.Contains(track.Id);

        if (isFavorite)
        {
            await Auth.RemoveFromLibraryAsync(uri);
            _favoriteTracks.Remove(track.Id);
        }
        else
        {
            await Auth.SaveToLibraryAsync(uri);
            _favoriteTracks.Add(track.Id);
        }

        StateHasChanged();
    }


    // --- PLAYBACK ---

    private async Task PlayTrack(PlaylistTrackItem item)
    {
        var track = item.Track;

        if (track == null || Playlist == null)
            return;

        // Determine index inside playlist
        int index = Tracks.FindIndex(t => t.Track?.Id == track.Id);

        if (index < 0)
            index = 0;

        // Play inside playlist context.
        // SpotifyAuthService will raise OnPlaybackChanged
        // after the playback request succeeds.
        await Auth.PlayTrackInContextAsync(Playlist.Uri, index);

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Track played: {track.Name}",
            context: $"Playlist: {Playlist.Name}, Artist: {string.Join(", ", track.Artists.Select(a => a.Name))}",
            page: "PlaylistDetailsPage",
            component: "TrackList",
            action: "TrackPlayed"
        );
    }


    // --- NAVIGATION ---

    private async Task OnAlbumClicked(PlaylistTrack track)
    {
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Album clicked: {track?.Album?.Name}",
            context: $"Artist: {string.Join(", ", track?.Artists?.Select(a => a.Name) ?? new List<string>())}",
            page: "PlaylistDetailsPage",
            component: "AlbumLink",
            action: "AlbumClicked"
        );

        Nav.NavigateTo($"/album/{track?.Album?.Id}");
    }

    private async Task OnArtistClicked(SimpleArtist artist)
    {
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Artist clicked: {artist?.Name}",
            context: null,
            page: "PlaylistDetailsPage",
            component: "ArtistLink",
            action: "ArtistClicked"
        );

        Nav.NavigateTo($"/artist/{artist.Id}");
    }


    // --- HELPERS ---

    private string FormatDuration(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}