@page "/playlist/{PlaylistId}"
@using SpotifyBlazor.Client.Services;
@using SpotifyBlazor.Shared.Models;
@inject SpotifyAuthService Auth
@inject NavigationManager Nav
@inject TelemetryService Telemetry

<h3>Playlist Details</h3>

@if (Playlist == null)
{
    <p>Loading playlist...</p>
}
else
{
    <div class="playlist-details-header">
        <img src="@Playlist.Images?.FirstOrDefault()?.Url"
             class="playlist-details-cover" />

        <div class="playlist-details-info">
            <h2>@Playlist.Name</h2>
            <p>@Playlist.Description</p>
            <p><strong>Owner:</strong> @Playlist.Owner.DisplayName</p>
            <p><strong>Total Tracks:</strong> @Tracks.Count</p>
        </div>
    </div>

    <h3>Tracks</h3>

    <ul class="track-list">
        @foreach (var t in Tracks)
        {
            <li class="track-item">

                <div class="track-left">
                    <img src="@(t.Track?.Album?.Images?.FirstOrDefault()?.Url ?? "")"
                         class="track-cover"
                         style="cursor:pointer"
                         @onclick="@(() => OnAlbumClicked(t.Track))" />

                    <div class="track-info">
                        <div class="track-name"
                             style="cursor:pointer"
                             @onclick="@(() => PlayTrack(t.Track))">
                            @t.Track?.Name
                        </div>

                        <div class="track-artist">
                            @foreach (var artist in t.Track?.Artists ?? new List<SimpleArtist>())
                            {
                                <span class="artist-link"
                                      style="cursor:pointer; text-decoration:underline;"
                                      @onclick="@(() => OnArtistClicked(artist))">
                                    @artist.Name
                                </span>

                                @if (artist != t.Track.Artists.Last())
                                {
                                    <span>, </span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="track-duration">
                    @FormatDuration(t.Track?.DurationMs ?? 0)
                </div>

            </li>
        }
    </ul>
}

@code {
    [Parameter] public string PlaylistId { get; set; }

    public SpotifyPlaylist Playlist { get; set; }
    public List<PlaylistTrackItem> Tracks { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Playlist = await Auth.GetPlaylistAsync(PlaylistId);
        Tracks = await Auth.GetPlaylistTracksAsync(PlaylistId);

        // 🔥 TELEMETRY: Playlist loaded
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Playlist loaded: {Playlist?.Name}",
            context: $"Owner: {Playlist?.Owner?.DisplayName}, Tracks: {Tracks?.Count}",
            page: "PlaylistDetailsPage",
            component: "PlaylistHeader",
            action: "PlaylistLoaded"
        );
    }

    private async Task PlayTrack(PlaylistTrack track)
    {
        // 🔥 TELEMETRY: Track played
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Track played: {track?.Name}",
            context: $"Album: {track?.Album?.Name}, Artist: {string.Join(", ", track?.Artists?.Select(a => a.Name) ?? new List<string>())}",
            page: "PlaylistDetailsPage",
            component: "TrackList",
            action: "TrackPlayed"
        );

        await Auth.PlayTrackAsync(track.Uri);
    }

    private async Task OnAlbumClicked(PlaylistTrack track)
    {
        // 🔥 TELEMETRY: Album clicked
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Album clicked: {track?.Album?.Name}",
            context: $"Artist: {string.Join(", ", track?.Artists?.Select(a => a.Name) ?? new List<string>())}",
            page: "PlaylistDetailsPage",
            component: "AlbumLink",
            action: "AlbumClicked"
        );

        Nav.NavigateTo($"/album/{track?.Album?.Id}");
    }

    private async Task OnArtistClicked(SimpleArtist artist)
    {
        // 🔥 TELEMETRY: Artist clicked
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Artist clicked: {artist?.Name}",
            context: null,
            page: "PlaylistDetailsPage",
            component: "ArtistLink",
            action: "ArtistClicked"
        );

        Nav.NavigateTo($"/artist/{artist.Id}");
    }

    private string FormatDuration(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
