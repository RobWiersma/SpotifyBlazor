@page "/playlists"
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject NavigationManager Nav
@inject TelemetryService Telemetry

<AnimatedPage>
    <h2 class="page-title">Your Playlists</h2>

    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to see your playlists.</p>
        </div>
    }
    else if (Playlistz == null)
    {
        <p class="page-message">Loading playlists…</p>
    }
    else if (Playlistz.Items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🎶</div>
            <p>You don't have any playlists yet.</p>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var p in Playlistz.Items)
            {
                <div class="media-card" @onclick="@(() => OnPlaylistClicked(p))">
                    @if (p.Images?.FirstOrDefault()?.Url is string cover)
                    {
                        <img src="@cover" class="media-card-image" alt="" />
                    }
                    else
                    {
                        <div class="media-card-image media-card-placeholder">🎶</div>
                    }

                    <div class="media-card-title">@p.Name</div>
                    <div class="media-card-subtitle">@p.Owner?.DisplayName • @p.Items?.Total tracks</div>
                </div>
            }
        </div>
    }
</AnimatedPage>

@code {
    public SpotifyPlaylistResponse? Playlistz { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += async state =>
        {
            if (state == LoginState.LoggedIn)
            {
                await LoadPlaylists();
                StateHasChanged();
            }
        };

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadPlaylists();

            await Telemetry.TrackAsync(
                level: "Info",
                message: "Playlists page loaded",
                context: $"Total playlists: {Playlistz?.Items?.Count}",
                page: "PlaylistsPage",
                component: "PlaylistGrid",
                action: "PageLoaded"
            );
        }
    }

    private async Task LoadPlaylists()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        Playlistz = await Auth.GetUserPlaylistsAsync();
    }

    private async Task OnPlaylistClicked(SpotifyPlaylist p)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Playlist clicked: {p.Name}",
            context: $"Owner: {p.Owner?.DisplayName}, Tracks: {p.Items?.Total}",
            page: "PlaylistsPage",
            component: "PlaylistCard",
            action: "PlaylistClicked"
        );

        Nav.NavigateTo($"/playlist/{p.Id}");
    }
}
