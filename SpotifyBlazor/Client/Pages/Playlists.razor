@page "/playlists"
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject NavigationManager Nav
@inject TelemetryService Telemetry

<h3>Your Playlists</h3>

@if (Auth.State != LoginState.LoggedIn)
{
    <p class="text-warning">You must be logged in to view your playlists.</p>
}
else if (Playlistz == null)
{
    <p>Loading playlists...</p>
}
else
{
    <div class="playlist-grid">
        @foreach (var p in Playlistz.Items)
        {
            <div class="playlist-card"
                 @onclick="@(() => OnPlaylistClicked(p))">

                <img src="@p.Images?.FirstOrDefault()?.Url"
                     class="playlist-cover" />

                <div class="playlist-name">@p.Name</div>
                <div class="playlist-owner">@p.Owner.DisplayName</div>
                <div class="playlist-count">@p.Items.Total tracks</div>
            </div>
        }
    </div>
}

@code {
    public SpotifyPlaylistResponse? Playlistz { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // React to login state changes
        Auth.LoginStateChanged += async state =>
        {
            if (state == LoginState.LoggedIn)
            {
                await LoadPlaylists();
                StateHasChanged();
            }
        };

        // If already logged in (page reload)
        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadPlaylists();

            await Telemetry.TrackAsync(
                level: "Info",
                message: "Playlists page loaded",
                context: $"Total playlists: {Playlistz?.Items?.Count}",
                page: "PlaylistsPage",
                component: "PlaylistGrid",
                action: "PageLoaded"
            );
        }
    }

    private async Task LoadPlaylists()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        Playlistz = await Auth.GetUserPlaylistsAsync();
    }

    private async Task OnPlaylistClicked(SpotifyPlaylist p)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Playlist clicked: {p.Name}",
            context: $"Owner: {p.Owner?.DisplayName}, Tracks: {p.Items?.Total}",
            page: "PlaylistsPage",
            component: "PlaylistCard",
            action: "PlaylistClicked"
        );

        Nav.NavigateTo($"/playlist/{p.Id}");
    }
}
