@page "/search"
@implements IDisposable
@inject NavigationManager Nav
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models

<AnimatedPage>

    <div class="search-page">

        @if (Auth.State != LoginState.LoggedIn)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🔒</div>
                <p>Log in with Spotify to search.</p>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(Q))
        {
            <div class="empty-state">
                <div class="empty-state-icon">🔎</div>
                <p>Search for songs, artists, or albums.</p>
            </div>
        }
        else
        {
            <h2 class="page-title">Results for <span>“@Q”</span></h2>

            <div class="chips">
                @foreach (var (key, label) in Filters)
                {
                    <button class="chip @(_filter == key ? "active" : "")"
                            @onclick="() => SetFilter(key)">
                        @label
                    </button>
                }

                <LengthFilter Minutes="_minMinutes" MinutesChanged="OnMinLengthChanged" />
            </div>

            @if (_isSearching)
            {
                <div class="search-skeleton">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="skeleton-row"></div>
                    }
                </div>
            }
            else if (_failed)
            {
                <div class="empty-state">
                    <p>Search failed.</p>
                    <button class="pill-btn" @onclick="RunSearch">Try again</button>
                </div>
            }
            else if (_results.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">🎧</div>
                    <p>No results for “@Q”. Check the spelling or try something else.</p>
                </div>
            }
            else
            {
                @switch (_filter)
                {
                    case "all":
                        @RenderAll()
                        break;
                    case "track":
                        @if (_minMinutes > 0)
                        {
                            @RenderLongTracks()
                        }
                        else
                        {
                            @RenderSongs(Tracks, showAlbum: true)
                        }
                        break;
                    case "artist":
                        @RenderArtists(Artists)
                        break;
                    case "album":
                        @RenderAlbums(Albums)
                        break;
                }
            }
        }

    </div>

</AnimatedPage>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private string? _lastQuery;
    private bool _isSearching;
    private bool _failed;
    private string _filter = "all";
    private List<SearchResult> _results = new();

    private static readonly (string Key, string Label)[] Filters =
    {
        ("all", "All"), ("track", "Songs"), ("artist", "Artists"), ("album", "Albums")
    };

    // --- "Longer than" filter ---
    // Spotify search can't filter by length, so this pages through the song results
    // (Spotify stops at 1,000) and keeps the long ones.
    private const int SpotifyMaxOffset = 1000;
    private const int MatchesPerBatch = 20;
    private const int RequestsPerBatch = 8;
    private const int ResultsPerBatch = 200;

    private double _minMinutes;
    private readonly List<SearchResult> _longTracks = new();
    private int _scanned;
    private int _total = -1;        // -1 until Spotify has said how many songs match
    private bool _scanning;
    private bool _scanFailed;
    private int _scanGeneration;    // bumped on every reset so an older scan stops

    private bool CanScanMore =>
        _scanned < (_total < 0 ? SpotifyMaxOffset : Math.Min(_total, SpotifyMaxOffset));

    private IEnumerable<SearchResult> Tracks => _results.Where(r => r.Type == "track");
    private IEnumerable<SearchResult> Artists => _results.Where(r => r.Type == "artist");
    private IEnumerable<SearchResult> Albums => _results.Where(r => r.Type == "album");

    // Spotify-style: an artist whose name matches the query exactly wins, otherwise the top track
    private SearchResult? TopResult =>
        Artists.FirstOrDefault(a => string.Equals(a.Name, Q?.Trim(), StringComparison.OrdinalIgnoreCase))
        ?? Tracks.FirstOrDefault()
        ?? _results.FirstOrDefault();

    // --- LIFECYCLE ---

    protected override void OnInitialized()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Runs again when the header search box navigates here with a new ?q=
        if (Q == _lastQuery)
            return;

        _lastQuery = Q;

        // A length filter carries over to a new search, showing its songs straight away
        _filter = _minMinutes > 0 ? "track" : "all";
        ResetLongScan();

        if (Auth.State == LoginState.LoggedIn)
        {
            await RunSearch();

            if (_minMinutes > 0)
                await ScanMoreAsync();
        }
    }

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await RunSearch();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
    }

    // --- SEARCH ---

    private async Task RunSearch()
    {
        if (Auth.State != LoginState.LoggedIn || string.IsNullOrWhiteSpace(Q))
        {
            _results = new();
            return;
        }

        _isSearching = true;
        _failed = false;
        StateHasChanged();

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Search executed: {Q}",
            context: null,
            page: "SearchPage",
            component: "SearchBox",
            action: "SearchExecuted"
        );

        try
        {
            _results = await Auth.SearchAsync(Q);
        }
        catch
        {
            _results = new();
            _failed = true;
        }

        _isSearching = false;

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Search results received: {_results.Count} items",
            context: $"Query: {Q}",
            page: "SearchPage",
            component: "SearchResults",
            action: "ResultsReceived"
        );
    }

    private void SetFilter(string filter) => _filter = filter;

    private async Task OnMinLengthChanged(double minutes)
    {
        _minMinutes = minutes;
        ResetLongScan();

        if (_minMinutes > 0)
        {
            _filter = "track";
            await ScanMoreAsync();
        }
    }

    private void ResetLongScan()
    {
        _scanGeneration++;
        _longTracks.Clear();
        _scanned = 0;
        _total = -1;
        _scanning = false;
        _scanFailed = false;
    }

    // Pages through song results until this batch has found enough long songs,
    // made enough requests, or reached the end
    private async Task ScanMoreAsync()
    {
        if (_scanning || string.IsNullOrWhiteSpace(Q) || _minMinutes <= 0)
            return;

        var generation = _scanGeneration;
        var query = Q;
        var minMs = _minMinutes * 60_000;  // fractional minutes compare fine against whole ms
        var found = 0;
        var requests = 0;

        _scanning = true;
        _scanFailed = false;
        StateHasChanged();

        try
        {
            // Look through about 200 results per batch, whatever page size Spotify allows this app
            while (found < MatchesPerBatch &&
                   requests < Math.Max(RequestsPerBatch, ResultsPerBatch / Auth.SearchPageSize) &&
                   CanScanMore)
            {
                var (tracks, total) = await Auth.SearchTracksAsync(query, _scanned);

                if (generation != _scanGeneration)
                    return;     // the filter or search changed meanwhile

                requests++;
                _total = total;
                _scanned += tracks.Count;

                if (tracks.Count == 0)
                {
                    _total = _scanned;  // Spotify ran out before its own count
                    break;
                }

                foreach (var t in tracks.Where(t => t.DurationMs >= minMs))
                {
                    if (_longTracks.All(x => x.Id != t.Id))
                    {
                        _longTracks.Add(t);
                        found++;
                    }
                }

                StateHasChanged();
            }
        }
        catch
        {
            if (generation == _scanGeneration)
                _scanFailed = true;
        }
        finally
        {
            if (generation == _scanGeneration)
            {
                _scanning = false;
                StateHasChanged();
            }
        }
    }

    // --- RENDERING ---

    private RenderFragment RenderAll() => __builder =>
    {
        var top = TopResult;

        <div class="search-top-row">

            @if (top != null)
            {
                <section class="page-section search-top">
                    <h3 class="section-title">Top result</h3>

                    <div class="search-top-card" @onclick="() => Open(top)">
                        <img src="@top.ImageUrl"
                             class="search-top-image @(top.Type == "artist" ? "round" : "")"
                             alt="" />

                        <div class="search-top-name">@top.Name</div>

                        <div class="search-top-meta">
                            @if (top.Artists.Any())
                            {
                                <span>@string.Join(", ", top.Artists.Select(a => a.Name))</span>
                            }
                            <span class="search-type-pill">@TypeLabel(top.Type)</span>
                        </div>

                        @if (top.Type == "track")
                        {
                            <button class="search-play-btn"
                                    title="Play"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => Play(top)">▶</button>
                        }
                    </div>
                </section>
            }

            @if (Tracks.Any())
            {
                <section class="page-section search-songs-preview">
                    <div class="section-header">
                        <h3 class="section-title">Songs</h3>
                        <button class="see-all" @onclick='() => SetFilter("track")'>Show all</button>
                    </div>
                    @RenderSongs(Tracks.Take(4), showAlbum: false)
                </section>
            }
        </div>

        @if (Artists.Any())
        {
            <section class="page-section">
                <div class="section-header">
                    <h3 class="section-title">Artists</h3>
                    <button class="see-all" @onclick='() => SetFilter("artist")'>Show all</button>
                </div>
                @RenderArtists(Artists.Take(6))
            </section>
        }

        @if (Albums.Any())
        {
            <section class="page-section">
                <div class="section-header">
                    <h3 class="section-title">Albums</h3>
                    <button class="see-all" @onclick='() => SetFilter("album")'>Show all</button>
                </div>
                @RenderAlbums(Albums.Take(6))
            </section>
        }
    };

    private RenderFragment RenderSongs(IEnumerable<SearchResult> tracks, bool showAlbum) => __builder =>
    {
        <div class="track-list">
            @foreach (var t in tracks)
            {
                <div class="track-row" @onclick="() => Play(t)">

                    <div class="track-row-art">
                        <img src="@t.ImageUrl" alt="" />
                        <span class="track-row-play">▶</span>
                    </div>

                    <div class="track-row-info">
                        <div class="track-row-name">@t.Name</div>
                        <div class="track-row-sub">
                            @foreach (var artist in t.Artists)
                            {
                                <span class="text-link"
                                      @onclick:stopPropagation="true"
                                      @onclick="() => GoToArtist(artist.Id)">@artist.Name</span>
                                @if (artist != t.Artists.Last())
                                {
                                    <span>, </span>
                                }
                            }
                        </div>
                    </div>

                    @if (showAlbum && !string.IsNullOrEmpty(t.AlbumName))
                    {
                        <div class="track-row-album">
                            <span class="text-link"
                                  @onclick:stopPropagation="true"
                                  @onclick="() => GoToAlbum(t.AlbumId)">@t.AlbumName</span>
                        </div>
                    }

                    <div class="track-row-meta">@FormatDuration(t.DurationMs)</div>
                </div>
            }
        </div>
    };

    private RenderFragment RenderLongTracks() => __builder =>
    {
        <p class="length-filter-status">
            @if (_scanning)
            {
                <span>Looking through songs… @_longTracks.Count longer than @_minMinutes min in the first @_scanned results so far</span>
            }
            else if (_scanFailed)
            {
                <span>Search stopped early. @_longTracks.Count songs found in the first @_scanned results.</span>
            }
            else
            {
                <span>@_longTracks.Count songs longer than @_minMinutes min in the first @_scanned of @(Math.Min(Math.Max(_total, 0), SpotifyMaxOffset)) results</span>
            }
        </p>

        @if (_longTracks.Any())
        {
            @RenderSongs(_longTracks, showAlbum: true)
        }
        else if (!_scanning)
        {
            <div class="empty-state">
                <div class="empty-state-icon">⏱️</div>
                <p>No songs longer than @_minMinutes min found yet.</p>
            </div>
        }

        @if (!_scanning && (CanScanMore || _scanFailed))
        {
            <div class="length-filter-more">
                <button class="pill-btn" @onclick="ScanMoreAsync">@(_scanFailed ? "Try again" : "Search deeper")</button>
            </div>
        }
    };

    private RenderFragment RenderArtists(IEnumerable<SearchResult> artists) => __builder =>
    {
        <div class="card-grid">
            @foreach (var a in artists)
            {
                <div class="media-card" @onclick="() => Open(a)">
                    @if (string.IsNullOrEmpty(a.ImageUrl))
                    {
                        <div class="media-card-image round media-card-placeholder">🎤</div>
                    }
                    else
                    {
                        <img src="@a.ImageUrl" class="media-card-image round" alt="" />
                    }
                    <div class="media-card-title">@a.Name</div>
                    <div class="media-card-subtitle">Artist</div>
                </div>
            }
        </div>
    };

    private RenderFragment RenderAlbums(IEnumerable<SearchResult> albums) => __builder =>
    {
        <div class="card-grid">
            @foreach (var a in albums)
            {
                <div class="media-card" @onclick="() => Open(a)">
                    @if (string.IsNullOrEmpty(a.ImageUrl))
                    {
                        <div class="media-card-image media-card-placeholder">💿</div>
                    }
                    else
                    {
                        <img src="@a.ImageUrl" class="media-card-image" alt="" />
                    }
                    <div class="media-card-title">@a.Name</div>
                    <div class="media-card-subtitle">
                        @(a.ReleaseYear != null ? $"{a.ReleaseYear} · " : "")@string.Join(", ", a.Artists.Select(x => x.Name))
                    </div>
                </div>
            }
        </div>
    };

    // --- ACTIONS ---

    private void Open(SearchResult item)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        _ = Telemetry.TrackAsync(
            level: "Info",
            message: $"Search result clicked: {item.Name}",
            context: $"Type: {item.Type}",
            page: "SearchPage",
            component: "SearchResults",
            action: "ResultClicked"
        );

        switch (item.Type)
        {
            case "track":
                _ = Play(item);
                break;
            case "artist":
                GoToArtist(item.Id);
                break;
            case "album":
                GoToAlbum(item.Id);
                break;
        }
    }

    private void GoToArtist(string? id)
    {
        if (!string.IsNullOrEmpty(id))
            Nav.NavigateTo($"/artist/{id}");
    }

    private void GoToAlbum(string? id)
    {
        if (!string.IsNullOrEmpty(id))
            Nav.NavigateTo($"/album/{id}");
    }

    private async Task Play(SearchResult track)
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Track played from search: {track.Id}",
            context: $"Query: {Q}",
            page: "SearchPage",
            component: "SearchResults",
            action: "TrackPlayed"
        );

        // Play inside the album context so next/previous work
        if (!string.IsNullOrEmpty(track.AlbumUri) && !string.IsNullOrEmpty(track.Uri))
            await Auth.PlayTrackInContextAsync(track.AlbumUri, track.Uri);
        else if (!string.IsNullOrEmpty(track.Uri))
            await Auth.PlayTrackAsync(track.Uri);
    }

    private static string TypeLabel(string type) => type switch
    {
        "track" => "Song",
        "artist" => "Artist",
        "album" => "Album",
        _ => type
    };

    private static string FormatDuration(int ms) => LengthFilter.Format(ms);
}
