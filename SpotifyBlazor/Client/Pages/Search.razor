@page "/search"
@inject NavigationManager Nav
@inject HttpClient Http
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models

<h2>Search Results</h2>

@if (IsSearching)
{
    <p>Searching...</p>
}

@if (Results?.Any() == true)
{
    <div class="results">
        @foreach (var item in Results)
        {
            <div class="result-item" @onclick="() => Navigate(item)">
                <img src="@item.ImageUrl" width="50" />
                <strong>@item.Name</strong>
                <span>@item.Type</span>
                <br />
                <br />
            </div>
        }
    </div>
}

@code {
    string Query = "";
    bool IsSearching = false;
    List<SearchResult> Results = new();

    protected override async Task OnParametersSetAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("q");

        if (q != Query)
        {
            Query = q;
            await RunSearch();
        }
    }

    async Task RunSearch()
    {
        IsSearching = true;

        // 🔥 TELEMETRY: Search executed
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Search executed: {Query}",
            context: null,
            page: "SearchPage",
            component: "SearchBox",
            action: "SearchExecuted"
        );

        var queryText = $"/api/search?q={Query}";
        Results = await Auth.SearchAsync(queryText);

        // 🔥 TELEMETRY: Search results received
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Search results received: {Results.Count} items",
            context: $"Query: {Query}",
            page: "SearchPage",
            component: "SearchResults",
            action: "ResultsReceived"
        );

        IsSearching = false;
    }

    void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Nav.NavigateTo($"/search?q={Query}");
        }
    }

    void Navigate(SearchResult item)
    {
        // 🔥 TELEMETRY: Search result clicked
        Telemetry.TrackAsync(
            level: "Info",
            message: $"Search result clicked: {item.Name}",
            context: $"Type: {item.Type}",
            page: "SearchPage",
            component: "SearchResults",
            action: "ResultClicked"
        );

        if (item.Type == "track")
        {
            _ = Play(item.Id);
            return;
        }

        switch (item.Type)
        {
            case "artist":
                Nav.NavigateTo($"/artist/{item.Id}");
                break;
            case "album":
                Nav.NavigateTo($"/album/{item.Id}");
                break;
        }
    }

    async Task Play(string id)
    {
        // 🔥 TELEMETRY: Track played from search
        await Telemetry.TrackAsync(
            level: "Info",
            message: $"Track played from search: {id}",
            context: $"Query: {Query}",
            page: "SearchPage",
            component: "SearchResults",
            action: "TrackPlayed"
        );

        await Auth.PlayTrackAsync(id);
    }
}
