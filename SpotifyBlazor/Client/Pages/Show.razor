@page "/show/{ShowId}"
@implements IDisposable

@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject SpotifyAuthService Auth
@inject NavigationManager Nav
@inject TelemetryService Telemetry

<AnimatedPage>
    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <p>Log in with Spotify to view this podcast.</p>
        </div>
    }
    else if (_show == null)
    {
        <p class="page-message">Loading podcast…</p>
    }
    else
    {
        <div class="media-header">
            <img src="@_show.Images.FirstOrDefault()?.Url"
                 class="media-header-cover" alt="" />

            <div class="media-header-info">
                <div class="media-header-kicker">Podcast</div>
                <h1 class="media-header-title">@_show.Name</h1>
                <p class="media-header-desc">@_show.Description</p>
                <div class="media-header-meta fw-bold">@_show.Publisher</div>
            </div>
        </div>

        <section class="page-section">
            <h3 class="section-title">Episodes</h3>

            @if (_episodes == null)
            {
                <p class="page-message">Loading episodes…</p>
            }
            else
            {
                <ul class="episode-list">
                    @foreach (var ep in _episodes.Items)
                    {
                        <li class="episode-card">
                            <div class="episode-title">@ep.Name</div>
                            <div class="episode-date">@ep.ReleaseDate.ToShortDateString()</div>
                            <div class="episode-desc">@ep.Description</div>

                            <button class="pill-btn primary"
                                    @onclick="@(() => PlayEpisode(ep))">
                                ▶ Play episode
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</AnimatedPage>

@code {
    [Parameter] public string ShowId { get; set; } = string.Empty;

    private SpotifyShow? _show;
    private SpotifyShowEpisodes? _episodes;


    // --- INIT ---

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += HandleLoginStateChanged;
        Auth.OnPlaybackChanged += HandlePlaybackChangedAsync;

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadShow();

            await Telemetry.TrackAsync(
                "Info",
                $"Show page loaded: {_show?.Name}",
                context: $"ShowId: {ShowId}",
                page: "ShowPage",
                component: "ShowDetail",
                action: "PageLoaded"
            );
        }
    }


    // --- EVENTS ---

    private async void HandleLoginStateChanged(LoginState state)
    {
        if (state == LoginState.LoggedIn)
        {
            await LoadShow();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandlePlaybackChangedAsync()
    {
        // Playback changed elsewhere in the application.
        //
        // The show/episode data itself hasn't changed, so there
        // is no need to make another Spotify API request here.

        await InvokeAsync(StateHasChanged);
    }


    // --- DISPOSE ---

    public void Dispose()
    {
        Auth.LoginStateChanged -= HandleLoginStateChanged;
        Auth.OnPlaybackChanged -= HandlePlaybackChangedAsync;
    }


    // --- LOAD SHOW ---

    private async Task LoadShow()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        _show = await Auth.GetShowAsync(ShowId);
        _episodes = await Auth.GetShowEpisodesAsync(ShowId);
    }


    // --- PLAYBACK ---

    private async Task PlayEpisode(SpotifyEpisode ep)
    {
        await Telemetry.TrackAsync(
            "Info",
            $"Episode played: {ep.Name}",
            context: $"Show: {_show?.Name}",
            page: "ShowPage",
            component: "EpisodeList",
            action: "EpisodePlayed"
        );

        // SpotifyAuthService raises OnPlaybackChanged
        // after the playback request succeeds.
        await Auth.PlayEpisodeAsync(ep.Id);
    }
}