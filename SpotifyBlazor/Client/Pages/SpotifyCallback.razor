@page "/spotcallback"
@using System.Text.Json
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject NavigationManager Nav
@inject HttpClient Http
@inject SpotifyAuthService Auth
@inject IJSRuntime JS

<h3>Spotify Callback</h3>

@if (!string.IsNullOrEmpty(Code))
{
    <p><strong>Code received:</strong> @Code</p>
}

@code {
    public string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        Console.WriteLine("Callback URL: " + uri);

        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        Code = query["code"];

        Console.WriteLine("Extracted Code: " + Code);

        if (string.IsNullOrEmpty(Code))
        {
            Console.WriteLine("No code found in callback URL.");
            return;
        }

        // 1. Exchange authorization code for Spotify tokens
        Console.WriteLine("Exchanging code for Spotify tokens...");
        var tokenResponse = await Http.PostAsJsonAsync("/api/spotify/exchange", new { Code });

        if (!tokenResponse.IsSuccessStatusCode)
        {
            Console.WriteLine("Spotify token exchange failed.");
            return;
        }

        var token = await tokenResponse.Content.ReadFromJsonAsync<TokenResponseFull>();

        Console.WriteLine("Access Token: " + token?.access_token);
        Console.WriteLine("Refresh Token: " + token?.refresh_token);

        // Save Spotify tokens into AuthService + localStorage
        await Auth.SetInitialTokens(token);

        // 2. Exchange Spotify access token for API JWT
        Console.WriteLine("Exchanging Spotify access token for API JWT...");
        var jwtResponse = await Http.PostAsJsonAsync("/api/auth/spotify-login",
            new SpotifyLoginRequest { SpotifyAccessToken = token!.access_token });

        if (!jwtResponse.IsSuccessStatusCode)
        {
            Console.WriteLine("API JWT exchange failed.");
            return;
        }

        var jwtJson = await jwtResponse.Content.ReadFromJsonAsync<JsonElement>();
        var jwt = jwtJson.GetProperty("jwt").GetString();

        Console.WriteLine("API JWT: " + jwt);

        // 3. Apply JWT to HttpClient
        Auth.ApplyJwt(jwt);

        // 4. Save JWT to localStorage
        await JS.InvokeVoidAsync("localStorage.setItem", "api_jwt", jwt);

        // 5. Redirect home
        Nav.NavigateTo("/");
    }
}
