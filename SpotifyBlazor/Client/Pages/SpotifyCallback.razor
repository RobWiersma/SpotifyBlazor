@page "/spotcallback"
@using System.Text.Json
@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject NavigationManager Nav
@inject HttpClient Http
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@inject IJSRuntime JS

<h3>Logging in to Spotify…</h3>

@code {
    public string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Never log the callback URL or code: the code can be exchanged for tokens
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        Code = query["code"];

        if (string.IsNullOrEmpty(Code))
        {
            Console.WriteLine("No code found in callback URL.");

            if (Auth.State == LoginState.LoggedIn)
            {
                await Telemetry.TrackAsync("warn", "Callback missing code", page: "spotcallback");
            }

            return;
        }

        // ---------------------------------------------------------
        // 1. Exchange authorization code for Spotify tokens
        // ---------------------------------------------------------
        Console.WriteLine("Exchanging code for Spotify tokens...");

        if (Auth.State == LoginState.LoggedIn)
        {
            await Telemetry.TrackAsync("info", "Exchanging code for Spotify tokens", page: "spotcallback");
        }

        var tokenResponse = await Http.PostAsJsonAsync("/api/spotify/exchange", new { Code });

        if (!tokenResponse.IsSuccessStatusCode)
        {
            Console.WriteLine("Spotify token exchange failed.");

            if (Auth.State == LoginState.LoggedIn)
            {
                await Telemetry.TrackAsync("error", "Spotify token exchange failed",
                    tokenResponse.StatusCode.ToString(), page: "spotcallback");
            }

            return;
        }

        var token = await tokenResponse.Content.ReadFromJsonAsync<TokenResponseFull>();

        if (token is null)
        {
            Console.WriteLine("Spotify token exchange returned no token.");
            return;
        }

        if (Auth.State == LoginState.LoggedIn)
        {
            await Telemetry.TrackAsync("info", "Spotify tokens received",
                $"access={token?.access_token?.Length}, refresh={token?.refresh_token?.Length}",
                page: "spotcallback");
        }

        // ---------------------------------------------------------
        // 2. Let AuthService handle ALL JWT logic
        // ---------------------------------------------------------
        await Auth.SetInitialTokens(token);

        // If login failed, stop here
        if (Auth.State == LoginState.LoginFailed)
        {
            Console.WriteLine("Login failed inside SetInitialTokens.");

            await Telemetry.TrackAsync("crit", "LoginFailed in SetInitialTokens", page: "spotcallback");

            return;
        }

        // If still not logged in, do not continue
        if (Auth.State != LoginState.LoggedIn)
        {
            Console.WriteLine("User not logged in after SetInitialTokens.");
            return;
        }

        // ---------------------------------------------------------
        // 3. Persist JWT to localStorage (AuthService already applied it)
        // ---------------------------------------------------------
        await JS.InvokeVoidAsync("localStorage.setItem", "api_jwt", Auth.ApiJwt);

        await Telemetry.TrackAsync("info", "JWT stored + applied", page: "spotcallback");

        // ---------------------------------------------------------
        // 4. Redirect home
        // ---------------------------------------------------------
        Nav.NavigateTo("/");
    }
}
