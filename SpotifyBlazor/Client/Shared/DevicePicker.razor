@using SpotifyBlazor.Client.Services
@using SpotifyBlazor.Shared.Models
@inject SpotifyAuthService Auth
@inject WebPlayerService WebPlayer
@inject IJSRuntime JS
@implements IDisposable

<div class="device-picker-container" @onclick:stopPropagation="true">
    <button class="btn btn-dark" @onclick="ToggleMenu">
        🎧 Devices
    </button>

    @if (showMenu)
    {
        <div class="device-menu shadow-lg" @onclick:stopPropagation="true">
            @if (devices == null)
            {
                <div class="device-menu-item text-light small">Loading…</div>
            }
            else
            {
                @foreach (var d in devices)
                {
                    <button class="device-menu-item d-flex align-items-center gap-2"
                            disabled="@d.IsRestricted"
                            @onclick:stopPropagation="true"
                            @onclick="() => Switch(d.Id)"
                            style="@GetStyle(d)">
                        <span>@(d.Id == WebPlayer.DeviceId ? "🌐" : GetIcon(d.Type))</span>
                        <span>@(d.Id == WebPlayer.DeviceId ? "This browser" : d.Name)</span>
                    </button>
                }
            }

            @if (!string.IsNullOrEmpty(WebPlayer.Error))
            {
                <div class="device-menu-item text-warning small">@WebPlayer.Error</div>
            }
        </div>
    }
</div>

@code {
    private List<SpotifyDevice>? devices;
    private bool showMenu = false;

    // Devices are only polled while the menu is open; Spotify rate-limits the
    // whole app, so background polling from every DevicePicker adds up fast.
    private CancellationTokenSource? refreshCts;

    [Parameter]
    public EventCallback OnDeviceChanged { get; set; }

    private async Task AutoRefreshLoop(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                devices = await Auth.GetDevicesAsync();
                StateHasChanged();
                await Task.Delay(5000, token);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;

        if (showMenu)
        {
            refreshCts = new CancellationTokenSource();
            _ = AutoRefreshLoop(refreshCts.Token);
        }
        else
        {
            StopRefresh();
        }
    }

    private void StopRefresh()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();
        refreshCts = null;
    }

    public void Dispose() => StopRefresh();

    private async Task Switch(string id)
    {
        // Unlock browser audio while we're still inside the click gesture
        if (id == WebPlayer.DeviceId)
            await WebPlayer.ActivateAsync();

        await Auth.TransferPlaybackAsync(id);

        // Refresh device list
        devices = await Auth.GetDevicesAsync();

        // ⭐ Notify parent (VolumePopup)
        await OnDeviceChanged.InvokeAsync();

        showMenu = false;
        StopRefresh();
    }

    private string GetIcon(string type)
    {
        type = type?.ToLower() ?? "";

        if (type.Contains("computer")) return "💻";
        if (type.Contains("smartphone")) return "📱";
        if (type.Contains("speaker")) return "🔊";
        if (type.Contains("tablet")) return "📟";
        if (type.Contains("tv")) return "📺";
        if (type.Contains("game")) return "🎮";

        return "🎧";
    }

    private string GetStyle(SpotifyDevice d)
    {
        return d.IsActive
            ? "border-left: 4px solid #1db954; background-color:#1db95433;"
            : "";
    }
}
