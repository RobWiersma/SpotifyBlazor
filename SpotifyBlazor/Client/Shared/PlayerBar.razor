@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject NavigationManager Nav

<div id="playerbar" class="playerbar d-flex align-items-center gap-3 px-3 py-2">

    @if (Auth.State != LoginState.LoggedIn)
    {
        <span class="text-light small">
            @(Auth.State == LoginState.LoggingIn
                ? "Connecting to Spotify…"
                : Auth.State == LoginState.LoginFailed
                    ? "Login failed"
                    : "Not logged in")
        </span>
    }
    else if (current?.Item != null)
    {
        <img src="@current.Item.Album.Images.FirstOrDefault()?.Url"
             class="playerbar-art" @onclick="GoToNowPlaying" />

        <div class="track-info">
            <strong class="track-title">@current.Item.Name</strong>
            <span class="track-artist">@string.Join(", ", current.Item.Artists.Select(a => a.Name))</span>
        </div>

        <div class="player-controls-wrapper d-flex flex-column align-items-center">

            <div class="player-controls d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-dark" @onclick="PrevTrack">⏮</button>
                <button class="btn btn-sm btn-dark" @onclick="TogglePlayPause">
                    @(current?.IsPlaying == true ? "⏸" : "▶️")
                </button>
                <button class="btn btn-sm btn-dark" @onclick="NextTrack">⏭</button>
            </div>

            <div class="playerbar-progress w-100 mt-3">
                <div class="progress-bg" @ref="progressBarRef" @onclick="Seek">
                    <div class="progress-fill" style="width:@ProgressPercent%"></div>
                </div>

                <div class="d-flex justify-content-between text-light small mt-1">
                    <span>@FormatTime(current.ProgressMs)</span>
                    <span>@FormatTime(current.Item.DurationMs)</span>
                </div>
            </div>
        </div>

        <button class="mobile-tools-toggle btn btn-dark d-md-none" @onclick="ToggleMobileTools">
            ⚙️ Options
        </button>

        @if (showMobileTools)
        {
            <div class="mobile-tools-panel d-md-none">
                <VolumePopup @ref="VolumePopup" />
                <DevicePicker OnDeviceChanged="HandleDeviceChanged" />
            </div>
        }

        <div class="desktop-tools d-none d-md-block">
            <VolumePopup @ref="VolumePopup" />
        </div>

        <div class="desktop-tools d-none d-md-block">
            <DevicePicker OnDeviceChanged="HandleDeviceChanged" />
        </div>
    }
    else
    {
        <span>No music playing</span>
    }

</div>

@code {
    private IJSObjectReference? jsModule;
    private VolumePopup VolumePopup;

    private SpotifyNowPlaying? current;
    private bool refreshLoopStarted = false;
    private int apiRefreshCounter = 0;

    private ElementReference progressBarRef;
    private bool showMobileTools = false;

    private void ToggleMobileTools() => showMobileTools = !showMobileTools;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (current != null)
        {
            if (jsModule == null)
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/playerbar.js");

            await jsModule.InvokeVoidAsync("updateHeight");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += async state =>
        {
            if (state == LoginState.LoggedIn)
            {
                await LoadNowPlaying();
                StartRefreshLoop();
                StateHasChanged();
            }
            else
            {
                current = null;
                StateHasChanged();
            }
        };

        Auth.OnPlaybackChanged += async () =>
        {
            if (Auth.State == LoginState.LoggedIn)
            {
                apiRefreshCounter = 0;
                await LoadNowPlaying();
                StateHasChanged();
            }
        };

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadNowPlaying();
            StartRefreshLoop();
        }
    }

    private void StartRefreshLoop()
    {
        if (!refreshLoopStarted)
        {
            refreshLoopStarted = true;
            _ = RefreshLoop();
        }
    }

    private double ProgressPercent =>
        current?.Item == null
            ? 0
            : (double)current.ProgressMs / current.Item.DurationMs * 100;

    private async Task RefreshLoop()
    {
        while (true)
        {
            await Task.Delay(1000);

            if (Auth.State != LoginState.LoggedIn)
                continue;

            apiRefreshCounter++;

            if (apiRefreshCounter >= 10)
            {
                apiRefreshCounter = 0;
                await LoadNowPlaying();
            }

            StateHasChanged();
        }
    }

    private async Task LoadNowPlaying()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        current = await Auth.GetNowPlayingAsync();
    }

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    private async Task PrevTrack()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Auth.SkipToPreviousAsync();
        await LoadNowPlaying();
        StateHasChanged();
    }

    private async Task NextTrack()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Auth.SkipToNextAsync();
        await Task.Delay(300);

        for (int i = 0; i < 5; i++)
        {
            await LoadNowPlaying();
            if (current?.IsPlaying == true)
                break;

            await Task.Delay(200);
        }

        StateHasChanged();
    }

    private async Task TogglePlayPause()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        bool playing = current?.IsPlaying == true;

        if (playing)
            await Auth.PauseAsync();
        else
            await Auth.PlayAsync();

        await LoadNowPlaying();
        StateHasChanged();
    }

    private async Task Seek(MouseEventArgs e)
    {
        if (Auth.State != LoginState.LoggedIn || current?.Item == null)
            return;

        var width = await jsModule.InvokeAsync<double>("getWidth", progressBarRef);
        if (width <= 0)
            return;

        var percent = e.OffsetX / width;
        var newMs = (int)(current.Item.DurationMs * percent);

        await Auth.SeekAsync(newMs);

        current.ProgressMs = newMs;
        StateHasChanged();
    }

    private async Task HandleDeviceChanged()
    {
        if (VolumePopup != null)
            await VolumePopup.RefreshVolumeState();
    }

    private void GoToNowPlaying()
    {
        Nav.NavigateTo("/nowplaying");
    }
}
