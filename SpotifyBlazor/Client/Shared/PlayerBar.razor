@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="playerbar d-flex align-items-center gap-3 px-3 py-2">

    @if (Auth.State != LoginState.LoggedIn)
    {
        <span class="text-light small">
            @(Auth.State == LoginState.LoggingIn
                ? "Connecting to Spotify…"
                : Auth.State == LoginState.LoginFailed
                    ? "Login failed"
                    : "Not logged in")
        </span>
    }
    else if (nowPlaying?.Item != null)
    {
        <img src="@nowPlaying.Item.Album.Images.FirstOrDefault()?.Url"
             class="playerbar-art" />

        <div class="track-info">
            <strong class="track-title">@nowPlaying.Item.Name</strong>
            <span class="track-artist">@string.Join(", ", nowPlaying.Item.Artists.Select(a => a.Name))</span>
        </div>

        <div class="player-controls-wrapper d-flex flex-column align-items-center">

            <div class="player-controls d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-dark" @onclick="PrevTrack">⏮</button>
                <button class="btn btn-sm btn-dark" @onclick="TogglePlayPause">
                    @(nowPlaying?.IsPlaying == true ? "⏸" : "▶️")
                </button>
                <button class="btn btn-sm btn-dark" @onclick="NextTrack">⏭</button>
            </div>

            <div class="playerbar-progress w-100 mt-3">
                <div class="progress-bg" @ref="progressBarRef" @onclick="Seek">
                    <div class="progress-fill" style="width:@ProgressPercent%"></div>
                </div>

                <div class="d-flex justify-content-between text-light small mt-1">
                    <span>@FormatTime(nowPlaying.ProgressMs)</span>
                    <span>@FormatTime(nowPlaying.Item.DurationMs)</span>
                </div>
            </div>
        </div>

        <!-- ⭐ MOBILE TOOLS TOGGLE -->
        <button class="mobile-tools-toggle btn btn-dark d-md-none" @onclick="ToggleMobileTools">
            ⚙️ Options
        </button>

        @if (showMobileTools)
        {
            <div class="mobile-tools-panel d-md-none">
                <VolumePopup @ref="VolumePopup" />
                <DevicePicker OnDeviceChanged="HandleDeviceChanged" />
            </div>
        }

        <!-- ⭐ DESKTOP FLOATING CONTROLS -->
        <div class="desktop-tools d-none d-md-block">
            <VolumePopup @ref="VolumePopup" />
        </div>

        <div class="desktop-tools d-none d-md-block">
            <DevicePicker OnDeviceChanged="HandleDeviceChanged" />
        </div>
    }
    else
    {
        <span>No music playing</span>
    }

</div>

@code {
    private VolumePopup VolumePopup;

    private SpotifyNowPlaying? nowPlaying;
    private bool refreshLoopStarted = false;

    private ElementReference progressBarRef;

    private bool showMobileTools = false;

    private void ToggleMobileTools()
    {
        showMobileTools = !showMobileTools;
    }

    private async Task HandleDeviceChanged()
    {
        if (VolumePopup != null)
        {
            await VolumePopup.RefreshVolumeState();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += async state =>
        {
            if (state == LoginState.LoggedIn)
            {
                await LoadNowPlaying();

                if (!refreshLoopStarted)
                {
                    refreshLoopStarted = true;
                    _ = RefreshLoop();
                }

                StateHasChanged();
            }
            else
            {
                nowPlaying = null;
                StateHasChanged();
            }
        };

        Auth.OnPlaybackChanged += async () =>
        {
            if (Auth.State == LoginState.LoggedIn)
            {
                await LoadNowPlaying();
                StateHasChanged();
            }
        };

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadNowPlaying();

            if (!refreshLoopStarted)
            {
                refreshLoopStarted = true;
                _ = RefreshLoop();
            }
        }
    }

    private double ProgressPercent =>
        nowPlaying?.Item == null
            ? 0
            : (double)nowPlaying.ProgressMs / nowPlaying.Item.DurationMs * 100;

    private async Task RefreshLoop()
    {
        int apiRefreshCounter = 0;

        while (true)
        {
            await Task.Delay(1000);

            if (Auth.State != LoginState.LoggedIn)
                continue;

            apiRefreshCounter++;

            if (apiRefreshCounter >= 10)
            {
                apiRefreshCounter = 0;
                await LoadNowPlaying();
            }
            else if (nowPlaying?.IsPlaying == true)
            {
                nowPlaying.ProgressMs += 1000;
            }

            StateHasChanged();
        }
    }

    private async Task LoadNowPlaying()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        nowPlaying = await Auth.GetNowPlayingAsync();
    }

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    private async Task PrevTrack()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackTimedAsync(
            "Info",
            "PlayerBar.PrevTrack",
            async () =>
            {
                await Auth.SkipToPreviousAsync();
                await LoadNowPlaying();
            },
            context: "User pressed previous track",
            page: NavigationManager.Uri,
            component: nameof(PlayerBar),
            actionName: "PrevTrack"
        );

        StateHasChanged();
    }

    private async Task NextTrack()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Telemetry.TrackTimedAsync(
            "Info",
            "PlayerBar.NextTrack",
            async () =>
            {
                await Auth.SkipToNextAsync();

                await Task.Delay(300);

                for (int i = 0; i < 5; i++)
                {
                    await LoadNowPlaying();

                    if (nowPlaying?.IsPlaying == true)
                        break;

                    await Task.Delay(200);
                }
            },
            context: "User pressed next track",
            page: NavigationManager.Uri,
            component: nameof(PlayerBar),
            actionName: "NextTrack"
        );

        StateHasChanged();
    }

    private async Task TogglePlayPause()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        var isPlaying = nowPlaying?.IsPlaying == true;

        await Telemetry.TrackTimedAsync(
            "Info",
            isPlaying ? "PlayerBar.Pause" : "PlayerBar.Play",
            async () =>
            {
                if (isPlaying)
                    await Auth.PauseAsync();
                else
                    await Auth.PlayAsync();

                await LoadNowPlaying();
            },
            context: isPlaying ? "User paused playback" : "User started playback",
            page: NavigationManager.Uri,
            component: nameof(PlayerBar),
            actionName: isPlaying ? "Pause" : "Play"
        );

        StateHasChanged();
    }

    private async Task Seek(MouseEventArgs e)
    {
        if (Auth.State != LoginState.LoggedIn || nowPlaying?.Item == null)
            return;

        var width = await JS.InvokeAsync<double>("getWidth", progressBarRef);

        if (width <= 0)
            return;

        var percent = e.OffsetX / width;
        var newMs = (int)(nowPlaying.Item.DurationMs * percent);

        await Auth.SeekAsync(newMs);

        nowPlaying.ProgressMs = newMs;
        StateHasChanged();
    }
}
