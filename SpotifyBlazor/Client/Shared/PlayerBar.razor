@using SpotifyBlazor.Shared.Models
@using SpotifyBlazor.Client.Services
@inject SpotifyAuthService Auth
@inject TelemetryService Telemetry
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject NavigationManager Nav

<div id="playerbar" class="playerbar d-flex align-items-center px-3 py-2">

    @if (Auth.State != LoginState.LoggedIn)
    {
        <div class="pb-center text-light small">
            @(Auth.State == LoginState.LoggingIn
                ? "Connecting to Spotify…"
                : Auth.State == LoginState.LoginFailed
                    ? "Login failed"
                    : "Not logged in")
        </div>
    }
    else if (current?.Item != null)
    {
        <!-- LEFT SECTION (max 30%) -->
        <div class="pb-left d-flex align-items-center gap-3">
            <img src="@Artwork"
                 class="playerbar-art"
                 @onclick="GoToNowPlaying"/>

            <div class="track-info">
                <strong class="track-title">
                    @current?.Item?.Name
                </strong>

                <span class="track-artist">
                    @Subtitle
                </span>
            </div>

            @if (!IsEpisode)
            {
                <div class="fav-btn">
                    <button class="btn btn-sm btn-dark" @onclick="ToggleFavorite">
                        @(_isFavorite ? "💚" : "➕")
                    </button>
                </div>
            }

        </div>

        <!-- CENTER SECTION (perfectly centered controls) -->
        <div class="pb-center d-flex flex-column align-items-center">
            <div class="player-controls d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-dark" @onclick="ToggleShuffle">
                    @(shuffleEnabled ? "🔀" : "➡️")
                </button>

                <button class="btn btn-sm btn-dark" @onclick="PrevTrack">⏮</button>

                <button class="btn btn-sm btn-dark" @onclick="TogglePlayPause">
                    @(current?.IsPlaying == true ? "⏸" : "▶️")
                </button>

                <button class="btn btn-sm btn-dark" @onclick="NextTrack">⏭</button>

                <button class="btn btn-sm btn-dark" @onclick="ToggleRepeat">
                    @(
                        repeatMode switch
                        {
                            "off" => "🔁",
                            "context" => "🔂",
                            "track" => "🔂🎵",
                            _ => "🔁"
                        }
                    )
                </button>
            </div>

            <div class="playerbar-progress w-100 mt-3">
                <div class="progress-bg" @ref="progressBarRef" @onclick="Seek">
                    <div class="progress-fill" style="width:@ProgressPercent%"></div>
                </div>

                <div class="d-flex justify-content-between text-light small mt-1">
                    <span>@FormatTime(current.ProgressMs)</span>
                    <span>@FormatTime(current.Item.DurationMs)</span>
                </div>
            </div>
        </div>

        <!-- RIGHT SECTION (mirrors left width) -->
        <div class="pb-right d-flex align-items-center gap-3">

            <button class="queue-button d-none d-md-block"
                    @onclick="ToggleQueue">
                Queue
            </button>

            <div class="desktop-tools d-none d-md-block">
                <VolumePopup @ref="VolumePopup" />
            </div>

            <div class="desktop-tools d-none d-md-block">
                <DevicePicker OnDeviceChanged="HandleDeviceChanged" />
            </div>

            <button class="mobile-tools-toggle btn btn-dark d-md-none"
                    @onclick="ToggleMobileTools">
                ⚙️ Options
            </button>

            @if (showMobileTools)
            {
                <div class="mobile-tools-panel d-md-none">

                    <button class="mobile-option"
                            @onclick="ToggleQueue">
                        Queue
                    </button>

                    <VolumePopup @ref="VolumePopup" />

                    <DevicePicker OnDeviceChanged="HandleDeviceChanged" />

                </div>
            }

        </div>
    }
    else
    {
        <div class="pb-center text-light">No music playing</div>
    }

</div>

@if (_showQueue)
{
    <div class="queue-overlay" @onclick="CloseQueue">
        <div class="queue-panel" @onclick:stopPropagation>

            <div class="queue-header">
                <h3>Queue</h3>

                <button class="queue-close"
                        @onclick="CloseQueue">
                    ×
                </button>
            </div>

            @if (_loadingQueue)
            {
                <div class="queue-message">
                    Loading...
                </div>
            }
            else if (_queue.Count == 0)
            {
                <div class="queue-message">
                    Your queue is empty.
                </div>
            }
            else
            {
                <div class="queue-list">
                    @foreach (var track in _queue)
                    {
                        <div class="queue-item"
                             @onclick="() => PlayQueueTrack(track)">

                            @if (track.Album?.Images?.Count > 0)
                            {
                                <img src="@track.Album.Images[0].Url"
                                     class="queue-art"
                                     alt="@track.Name" />
                            }

                            <div class="queue-track-info">
                                <div class="queue-track-name">
                                    @track.Name
                                </div>

                                <div class="queue-track-artist">
                                    @string.Join(", ",
                                        track.Artists?.Select(a => a.Name)
                                        ?? Enumerable.Empty<string>())
                                </div>
                            </div>

                            <div class="queue-duration">
                                @FormatDuration(track.DurationMs)
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
}


@code {
    private bool IsEpisode =>
    current?.CurrentlyPlayingType == "episode";

    private bool _showQueue;
    private bool _loadingQueue;
    private List<SpotifyTrack> _queue = new();

    private string Artwork =>
    current?.Item?.Album?.Images?.FirstOrDefault()?.Url
    ?? current?.Item?.Images?.FirstOrDefault()?.Url
    ?? current?.Item?.Show?.Images?.FirstOrDefault()?.Url
    ?? "";

    private string Subtitle =>
    IsEpisode
    ? current?.Item?.Show?.Name ?? ""
    : string.Join(", ",
    current?.Item?.Artists?.Select(a => a.Name)
    ?? Enumerable.Empty<string>());

    private bool shuffleEnabled = false;
    private string repeatMode = "off";

    private IJSObjectReference? jsModule;
    private VolumePopup VolumePopup;

    private SpotifyPlayerState? current;
    private bool refreshLoopStarted = false;
    private int apiRefreshCounter = 0;

    private bool _isFavorite = false;

    private ElementReference progressBarRef;
    private bool showMobileTools = false;

    private void ToggleMobileTools() => showMobileTools = !showMobileTools;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (current != null)
        {
            if (jsModule == null)
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/playerbar.js");

            await jsModule.InvokeVoidAsync("updateHeight");
        }
    }

    private async Task ToggleQueue()
    {
        _showQueue = !_showQueue;

        if (_showQueue)
        {
            await LoadQueue();
        }
    }

    private void CloseQueue()
    {
        _showQueue = false;
    }

    private async Task LoadQueue()
    {
        _loadingQueue = true;

        try
        {
            var result = await Auth.GetQueueAsync();

            _queue = result?.Queue ?? new List<SpotifyTrack>();
        }
        finally
        {
            _loadingQueue = false;
        }
    }

    private async Task PlayQueueTrack(SpotifyTrack track)
    {
        if (!string.IsNullOrEmpty(track.Uri))
        {
            await Auth.PlayTrackAsync(track.Uri);
        }
    }

    private static string FormatDuration(int durationMs)
    {
        var time = TimeSpan.FromMilliseconds(durationMs);

        return time.TotalHours >= 1
            ? time.ToString(@"h\:mm\:ss")
            : time.ToString(@"m\:ss");
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.LoginStateChanged += async state =>
{
    if (state == LoginState.LoggedIn)
    {
        await LoadNowPlaying();
        await UpdateFavoriteState();
        await LoadQueue();

        StartRefreshLoop();

        await InvokeAsync(StateHasChanged);
    }
    else
    {
        current = null;
        _queue.Clear();

        await InvokeAsync(StateHasChanged);
    }
};

        Auth.OnPlaybackChanged += async () =>
{
    if (Auth.State == LoginState.LoggedIn)
    {
        apiRefreshCounter = 0;

        await LoadNowPlaying();
        await UpdateFavoriteState();
        await LoadQueue();

        await InvokeAsync(StateHasChanged);
    }
};

        if (Auth.State == LoginState.LoggedIn)
        {
            await LoadNowPlaying();
            await UpdateFavoriteState();
            StartRefreshLoop();
        }
    }

    private void StartRefreshLoop()
    {
        if (!refreshLoopStarted)
        {
            refreshLoopStarted = true;
            _ = RefreshLoop();
        }
    }

    private double ProgressPercent =>
        current?.Item == null
            ? 0
            : (double)current.ProgressMs / current.Item.DurationMs * 100;

    private async Task RefreshLoop()
    {
        while (true)
        {
            await Task.Delay(1000);

            if (Auth.State != LoginState.LoggedIn)
                continue;

            if (current?.IsPlaying == true && current.Item != null)
            {
                current.ProgressMs += 1000;

                if (current.ProgressMs > current.Item.DurationMs)
                    current.ProgressMs = current.Item.DurationMs;
            }

            apiRefreshCounter++;

            if (apiRefreshCounter >= 10)
            {
                apiRefreshCounter = 0;
                await LoadNowPlaying();
            }

            StateHasChanged();
        }
    }

    private async Task LoadNowPlaying()
    {
        var now = await Auth.GetNowPlayingAsync();

        if (now != null)
        {
            current = now;
            shuffleEnabled = now.ShuffleState;
            repeatMode = now.RepeatState;
        }

        StateHasChanged();
    }

    private async Task UpdateFavoriteState()
    {
        if (current?.Item == null || current.Item.Type == "episode")
        {
            _isFavorite = false;
            return;
        }

        string uri = $"spotify:{current.Item.Type}:{current.Item.Id}";
        _isFavorite = await Auth.IsFavoriteAsync(uri);
    }

    private string FormatTime(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    private async Task PrevTrack()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Auth.SkipToPreviousAsync();
        await LoadNowPlaying();
        await UpdateFavoriteState();
        StateHasChanged();
    }

    private async Task NextTrack()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        await Auth.SkipToNextAsync();
        await Task.Delay(300);

        for (int i = 0; i < 5; i++)
        {
            await LoadNowPlaying();
            if (current?.IsPlaying == true)
                break;

            await Task.Delay(200);
        }

        await UpdateFavoriteState();
        StateHasChanged();
    }

    private async Task TogglePlayPause()
    {
        if (Auth.State != LoginState.LoggedIn)
            return;

        bool playing = current?.IsPlaying == true;

        if (playing)
            await Auth.PauseAsync();
        else
            await Auth.PlayAsync();

        await LoadNowPlaying();
        await UpdateFavoriteState();
        StateHasChanged();
    }

    private async Task Seek(MouseEventArgs e)
    {
        if (Auth.State != LoginState.LoggedIn || current?.Item == null)
            return;

        var width = await jsModule.InvokeAsync<double>("getWidth", progressBarRef);
        if (width <= 0)
            return;

        var percent = e.OffsetX / width;
        var newMs = (int)(current.Item.DurationMs * percent);

        await Auth.SeekAsync(newMs);

        current.ProgressMs = newMs;
        StateHasChanged();
    }

    private async Task HandleDeviceChanged()
    {
        if (VolumePopup != null)
            await VolumePopup.RefreshVolumeState();
    }

    private void GoToNowPlaying()
    {
        Nav.NavigateTo("/nowplaying");
    }

    private async Task ToggleFavorite()
    {
        if (current?.Item == null || current.Item.Type == "episode")
            return;

        string uri = $"spotify:{current.Item.Type}:{current.Item.Id}";

        if (_isFavorite)
            await Auth.RemoveFromLibraryAsync(uri);
        else
            await Auth.SaveToLibraryAsync(uri);

        _isFavorite = !_isFavorite;
        StateHasChanged();
    }

    private async Task ToggleShuffle()
    {
        shuffleEnabled = !shuffleEnabled;

        await Telemetry.TrackTimedAsync(
            "Info",
            shuffleEnabled ? "PlayerBar.ShuffleOn" : "PlayerBar.ShuffleOff",
            async () =>
            {
                await Auth.SetShuffleAsync(shuffleEnabled);
            },
            context: shuffleEnabled ? "User enabled shuffle" : "User disabled shuffle",
            page: NavigationManager.Uri,
            component: nameof(PlayerBar),
            actionName: shuffleEnabled ? "ShuffleOn" : "ShuffleOff"
        );

        StateHasChanged();
    }

    private async Task ToggleRepeat()
    {
        repeatMode = repeatMode switch
        {
            "off" => "context",
            "context" => "track",
            "track" => "off",
            _ => "off"
        };

        await Telemetry.TrackTimedAsync(
            "Info",
            $"PlayerBar.Repeat.{repeatMode}",
            async () => await Auth.SetRepeatAsync(repeatMode),
            context: $"Repeat mode changed to {repeatMode}",
            page: NavigationManager.Uri,
            component: nameof(PlayerBar),
            actionName: $"Repeat.{repeatMode}"
        );

        StateHasChanged();
    }
}
