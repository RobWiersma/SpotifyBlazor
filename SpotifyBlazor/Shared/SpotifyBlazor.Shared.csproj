<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpotifyBlazor.Shared</RootNamespace>
  </PropertyGroup>

  <!-- No package references: this project is downloaded by every visitor's browser, so
       server-only packages (like Application Insights) belong in the Server project -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Classes\" />
  </ItemGroup>
</Project>
